# Firebase web config — get these from Vercel project Settings → Environment Variables
# (or Firebase Console → Project settings → "Your apps" → web app → SDK setup and configuration)
#
# Copy this file to `.env.local` (which is gitignored) and fill in the real values.
# CRA inlines REACT_APP_* vars at BUILD TIME, so any change here requires re-running
# `npm run build` (or `npm run ios:sync` for the iOS app).

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Optional — present if you use these features. Leave blank if not.
REACT_APP_FIREBASE_MEASUREMENT_ID=
REACT_APP_R2_ACCOUNT_ID=
REACT_APP_R2_ACCESS_KEY_ID=
REACT_APP_R2_SECRET_ACCESS_KEY=
REACT_APP_R2_BUCKET=
REACT_APP_R2_PUBLIC_BASE_URL=

# Cloudflare Worker URL + shared secret (firefc16-mailer). Powers
# email, push, and Google Places proxying. Required for any of those
# to work; emails/push fall back to no-op if unset.
REACT_APP_NOTIFY_URL=
REACT_APP_NOTIFY_SECRET=

# Mapbox public token (pk.…) — secondary search provider, used when
# Google isn't configured. Grab a free token at account.mapbox.com.
# Free tier: 100K search requests/month.
REACT_APP_MAPBOX_TOKEN=

# Google Places — PRIMARY search provider (best venue coverage). The
# API key lives as a worker secret (GOOGLE_PLACES_API_KEY on the
# Cloudflare Worker), NOT in the client bundle. Set it once via
# `wrangler secret put GOOGLE_PLACES_API_KEY` and the client picks it
# up automatically via the existing notify proxy. No client-side
# env var needed — the client uses REACT_APP_NOTIFY_URL/SECRET (above)
# to reach the worker.
