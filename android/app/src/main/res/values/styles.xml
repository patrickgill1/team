<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Opt out of Android 15's forced edge-to-edge so the WebView
             doesn't draw underneath the status bar (top of the app was
             getting clipped behind the system clock) or the gesture
             nav bar (composer was sitting underneath it). Honored on
             API 35+; ignored on older Android where the WebView is
             already insetted by default. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <!-- Paint the status / nav bars and the activity window
             background with the app's navy so the insetted strip
             above the WebView blends into the system bar instead of
             flashing white. Matches the runtime StatusBar plugin
             color (#0f172a) set in src/utils/nativeShell.ts. -->
        <item name="android:statusBarColor">#0f172a</item>
        <item name="android:navigationBarColor">#0f172a</item>
        <item name="android:windowBackground">#0f172a</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>