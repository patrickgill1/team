rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public: anyone can read active votings (for the /vote page)
    match /match_votings/{votingId} {
      allow read: if true;
      // Allow votes to be cast (update votes array) without auth
      allow update: if true;
      // Only authenticated users can create/delete votings
      allow create, delete: if request.auth != null;
    }

    // Public: anyone can read player profiles (needed to show player cards on vote page)
    match /players/{playerId} {
      allow read: if true;
      // Only authenticated users can write player data
      allow write: if request.auth != null;
    }

    // All other collections require authentication
    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /news/{newsId} {
      allow read, write: if request.auth != null;
    }

    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }

    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /player_media/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gallery/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /full_games/{gameId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /stats/{statId} {
      allow read, write: if request.auth != null;
    }

    match /development_plans/{planId} {
      allow read, write: if request.auth != null;
    }

    match /attendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    match /volunteers/{volunteerId} {
      allow read, write: if request.auth != null;
    }

    // Surveys: public read for shared links, creator controls edits
    match /surveys/{surveyId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Anyone can increment responseCount (public survey submissions); only creator can change other fields
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount']))
        || (request.auth != null && resource.data.createdBy == request.auth.uid);
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // Survey responses: anyone can submit, only creator can read
    match /survey_responses/{responseId} {
      allow create: if request.resource.data.surveyId is string;

      allow read: if request.auth != null
        && resource.data.surveyId is string
        && get(/databases/$(database)/documents/surveys/$(resource.data.surveyId)).data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }

    // Catch-all: deny everything else by default
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
