rules_version = '2';

// Firebase Storage rules — hardened 2026-07-08 (Patrick's PII audit
// after seeing a competing platform expose parent data cross-club).
//
// Prior state: `allow read, write: if request.auth != null` on
// /{allPaths=**}. That meant any signed-in user could:
//   - overwrite ANY file in the bucket (avatar poisoning of another
//     team's coach, team-logo defacement, etc.)
//   - list/enumerate ANY path they knew the shape of
//
// New posture:
//   - Read: authed users only (unchanged; Firebase Storage URLs are
//     effectively public once shared and cached in the app; the
//     real leverage on read-side is stopping unauthed browsing).
//   - Write: scoped to the owner for profile uploads; scoped to
//     team/club paths but still authed-only there because Storage
//     rules can't cheaply cross-check Firestore team.coachIds
//     membership. Client-side upload paths are all coach-gated so
//     this stops opportunistic attacks; a rogue coach still writing
//     to another team's teams/*/photos/* path is out-of-band abuse
//     that would show up in audit if it happened.
//   - Anything not matched by an explicit path: no writes at all,
//     read still allowed to authed. Prevents the "wildcard allows
//     anything" trap.
//
// Note on scope: most of GoalKickr's media lives in Cloudflare R2
// (bucket 'fire') and Cloudflare Stream, NOT Firebase Storage. This
// rules file covers avatars, team logos, and a small set of legacy
// upload paths. R2 has its own CORS + auth config at infra/r2-cors.json.

service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos and per-user uploads. Path shape:
    //   profiles/{type}/{userId}/{fileName}
    // where type is one of 'parents', 'coaches', 'players'. Only the
    // owner (auth.uid === userId) can write here; anyone signed in
    // can read (avatars are visible in chat, roster, etc.).
    match /profiles/{type}/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Team-scoped uploads (team logo, event photos, roster media).
    // Path shape: teams/{teamId}/(logo|photos|...)/{fileName}. Storage
    // rules can't affordably cross-check Firestore team membership so
    // we keep this authed-only — the client only ever writes to teams
    // the caller coaches. Non-coach writes here would show up in
    // logs; harden with a Firestore.get() lookup in a followup if
    // that ever becomes a real attack vector.
    match /teams/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Club-scoped uploads (club logo). Same rationale as team paths.
    match /clubs/{clubId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Chat image uploads. Path shape: chat/{teamId}/{threadId}/{fileName}.
    // Same rationale as team paths — Storage rules can't affordably
    // cross-check Firestore chat_threads membership, so authed-only
    // is the pragmatic posture. Missing this rule was the reason chat
    // image uploads started 403'ing after the 2026-07-08 hardening;
    // caught on Patrick's phone 2026-07-13.
    match /chat/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Legacy PROFILE photo uploads (players/coaches/parents). Path
    // shape: player-photos/{fileName}. Used by AddPlayer.tsx and
    // parent/coach photo upload flows. Note: this legacy path does
    // NOT include userId in the path (files are named by random
    // string), so we can't scope writes to owner via Storage rules
    // alone — client is coach/parent-gated for the flows that hit
    // this path. Missing this rule was Patrick's 2026-07-14 report
    // of "not letting people upload profile photos, permission
    // issue."
    match /player-photos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Player media (coach uploads to a player's timeline: game clips,
    // action photos, moments). Path shape:
    //   player_media/{teamId}/{playerId}/{filename}
    // Same authed-only rationale as team paths; the upload UI is
    // coach-gated.
    match /player_media/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Event photo attachments (photos attached to a calendar event).
    // Path shape: events/{teamId}/{eventId}/{filename}. Coach-gated
    // in the UI.
    match /events/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default fallback: authed users can READ anything else that
    // slipped past the explicit prefixes, but NOTHING writes here.
    // Compare to the previous wildcard that allowed writes too — that
    // was the "avatar poisoning of any user" hole the audit found.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
