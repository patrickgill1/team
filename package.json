{
  "name": "soccer-team-app",
  "version": "3.9.179",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@capacitor-firebase/authentication": "^5.4.1",
    "@capacitor-firebase/messaging": "^5.4.1",
    "@capacitor/android": "^7.6.5",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.2",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.2",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/push-notifications": "^7.0.6",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@capawesome/capacitor-badge": "^8.0.2",
    "@capgo/capacitor-updater": "^8.49.2",
    "@capgo/cli": "^8.5.3",
    "@sentry/react": "^10.64.0",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.11.47",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^8.3.4",
    "firebase": "^9.9.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "react-swipeable": "^7.0.2",
    "terser": "^5.46.1",
    "typescript": "^4.7.4",
    "uuid": "^8.3.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "react-scripts start",
    "prebuild": "node ./scripts/ensure-clean-tree.js",
    "build": "REACT_APP_VERSION=$npm_package_version DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "build:dirty": "DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "ios:add": "cap add ios && cap sync ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "capgo:push": "npm run build && npx @capgo/cli bundle upload -c production",
    "capgo:canary": "npm run build && npx @capgo/cli bundle upload -c canary",
    "capgo:status": "npx @capgo/cli app list && npx @capgo/cli bundle list"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.2",
    "firebase-admin": "^13.8.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0"
  }
}
