rules_version = '2';
// ──────────────────────────────────────────────────────────────────
// GoalKickr Firestore rules — multi-tenant safe.
//
// Pre-rewrite, most collections were `allow read, write: if request.auth
// != null` which meant any signed-in user on any team/club could read +
// write any document. Fine while there was one club. Dangerous before
// onboarding a second.
//
// This rewrite enforces per-team and per-club membership server-side.
// Helpers at the top look up the requesting user's user doc once and
// derive their team / club memberships. Each collection's rules use
// those helpers to gate reads + writes.
//
// Public surfaces (no-auth pages) explicitly stay open: share links for
// events / wall posts / POTM votes, /register and /offer/:id no-auth
// flows, public player profiles for the vote page.
// ──────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ─────────────────────────────────────────────────

    // Hydrate the requesting user's user doc. ONE get() per evaluation,
    // memoized by Firestore — call freely from other helpers.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // User's set of team memberships. Tolerates either the legacy
    // single-team field (teamId) OR the multi-team field (teamIds).
    // Returns a list either way so callers can use `in` and `hasAny`.
    function userTeamIds() {
      return (userDoc().teamIds is list ? userDoc().teamIds : [])
        .concat(userDoc().teamId is string && userDoc().teamId != '' ? [userDoc().teamId] : []);
    }

    // User's set of club memberships. Same shape tolerance as teams.
    function userClubIds() {
      return (userDoc().clubIds is list ? userDoc().clubIds : [])
        .concat(userDoc().clubId is string && userDoc().clubId != '' ? [userDoc().clubId] : []);
    }

    function isAuthed() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function isTeamMember(teamId) {
      return isAuthed() && teamId is string && teamId in userTeamIds();
    }

    function isClubMember(clubId) {
      return isAuthed() && clubId is string && clubId in userClubIds();
    }

    function isClubAdmin(clubId) {
      return isAuthed()
        && userDoc().isClubAdmin == true
        && clubId in userClubIds();
    }

    // Platform owner — Patrick. Has a few god-mode capabilities (set
    // platformFeeBps, delete clubs, etc.). Email-based check matches
    // the previous rules.
    function isPlatformOwner() {
      return isAuthed() && request.auth.token.email == 'patrickgill4@gmail.com';
    }

    // Resource matches one of the user's teams. Accepts a single
    // teamId field OR a teamIds list (for multi-team docs like a
    // player who's been moved between rosters).
    function resourceOnUserTeam(res) {
      return isAuthed() && (
        (res.teamId is string && res.teamId in userTeamIds())
        || (res.teamIds is list && res.teamIds.hasAny(userTeamIds()))
      );
    }

    function resourceOnUserClub(res) {
      return isAuthed() && res.clubId is string && res.clubId in userClubIds();
    }

    // ── PUBLIC: POTM voting ─────────────────────────────────────
    // The vote page is a no-auth shareable link.

    match /match_votings/{votingId} {
      allow read: if true;
      allow update: if true; // cast vote without auth
      allow create, delete: if isAuthed();
    }

    // ── PUBLIC: player profiles ────────────────────────────────
    // The POTM vote page renders player cards by id; needs public read.
    // Writes restricted to team coaches.

    match /players/{playerId} {
      allow read: if true;
      allow create: if isAuthed() && resourceOnUserTeam(request.resource.data);
      allow update, delete: if isAuthed() && resourceOnUserTeam(resource.data);
    }

    // ── USER DOCS ──────────────────────────────────────────────
    // Reads stay open across the signed-in surface (avatar lookups,
    // team-member listings, parent-email matching). Writes locked to
    // the user themself OR a club admin whose club this user belongs to.

    match /users/{userId} {
      allow read: if isAuthed();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId)
        || isPlatformOwner()
        || (isAuthed()
            && userDoc().isClubAdmin == true
            && get(/databases/$(database)/documents/users/$(userId)).data.clubId is string
            && get(/databases/$(database)/documents/users/$(userId)).data.clubId in userClubIds());
      allow delete: if isSelf(userId) || isPlatformOwner();
    }

    // ── TEAMS ──────────────────────────────────────────────────
    // Read open to authed users (team picker, parent-of-X lookups).
    // Writes restricted to team coaches / club admins.

    match /teams/{teamId} {
      allow read: if isAuthed();
      allow create: if isAuthed(); // creator becomes the first coach via app logic
      allow update, delete: if isAuthed() && (
        isTeamMember(teamId)
        || (resource.data.clubId is string && isClubAdmin(resource.data.clubId))
      );
    }

    // ── EVENTS ─────────────────────────────────────────────────
    // Public read so /event/:id share links work.
    // Public update only when the diff is publicRsvps (no-auth guest
    // RSVP). Other writes require team membership.

    match /events/{eventId} {
      allow read: if true;
      allow create: if isTeamMember(request.resource.data.teamId);
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicRsvps']))
        || (isAuthed() && resourceOnUserTeam(resource.data));
      allow delete: if isAuthed() && resourceOnUserTeam(resource.data);
    }

    // ── NEWS ───────────────────────────────────────────────────
    // Currently auth-only, no teamId field on existing news docs.
    // Keep auth-required while news exists; revisit if news gets
    // team scope later.

    match /news/{newsId} {
      allow read, write: if isAuthed();
    }

    // ── LEGACY messages collection ─────────────────────────────
    // No teamId field today; auth-required. Slated for removal once
    // confirmed nothing reads from it.

    match /messages/{messageId} {
      allow read, write: if isAuthed();
    }

    // ── CHAT THREADS ───────────────────────────────────────────
    // Already had private/participant gating; tightening to require
    // team membership for non-private threads too.

    match /chat_threads/{threadId} {
      function isPrivate() {
        return resource.data.isDM == true || resource.data.isGroup == true;
      }
      function hasParticipantsList() {
        return resource.data.participants is list;
      }
      function isParticipant() {
        return isAuthed() && hasParticipantsList() && request.auth.uid in resource.data.participants;
      }
      allow read: if isAuthed() && (
        isParticipant()
        || (!isPrivate() && resourceOnUserTeam(resource.data))
        || (!isPrivate() && !hasParticipantsList()) // legacy escape hatch
      );
      allow create: if isAuthed() && (
        // Creator on a team thread must be on that team
        (request.resource.data.teamId is string && isTeamMember(request.resource.data.teamId))
        // OR creating a DM/group — participants check enforced via update rules
        || request.resource.data.isDM == true
        || request.resource.data.isGroup == true
      );
      allow update: if isAuthed() && (
        isParticipant()
        || (!isPrivate() && resourceOnUserTeam(resource.data))
      );
      allow delete: if isAuthed() && (
        isParticipant()
        || (!isPrivate() && resourceOnUserTeam(resource.data))
      );
    }

    // ── CHAT MESSAGES ──────────────────────────────────────────
    // Membership of the thread the message lives under. One extra
    // get() per message rule check; acceptable for chat traffic.

    match /chat_messages/{messageId} {
      function thread() {
        return get(/databases/$(database)/documents/chat_threads/$(resource.data.threadId)).data;
      }
      function newThread() {
        return get(/databases/$(database)/documents/chat_threads/$(request.resource.data.threadId)).data;
      }
      allow read: if isAuthed() && (
        // Private thread → must be participant
        (thread().isDM == true || thread().isGroup == true)
          ? (thread().participants is list && request.auth.uid in thread().participants)
          : (thread().teamId is string && isTeamMember(thread().teamId))
      );
      allow create: if isAuthed() && (
        (newThread().isDM == true || newThread().isGroup == true)
          ? (newThread().participants is list && request.auth.uid in newThread().participants)
          : (newThread().teamId is string && isTeamMember(newThread().teamId))
      );
      allow update, delete: if isAuthed() && resource.data.senderId == request.auth.uid;
    }

    // ── WALL POSTS ─────────────────────────────────────────────
    // Already had author/admin checks. Adding team-membership gate on
    // reads + creation so posts don't leak across teams.

    match /wall_posts/{postId} {
      allow read: if resource.data.isPublic == true
        || (isAuthed() && resourceOnUserTeam(resource.data));
      allow create: if isAuthed()
        && request.resource.data.senderId == request.auth.uid
        && isTeamMember(request.resource.data.teamId);
      allow update: if isAuthed() && (
        // Author or club admin can edit content
        (resource.data.senderId == request.auth.uid)
        || (resource.data.clubId is string && isClubAdmin(resource.data.clubId))
        // OR anyone on the team can update reactions only
        || (resourceOnUserTeam(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
      );
      allow delete: if isAuthed() && (
        resource.data.senderId == request.auth.uid
        || (resource.data.clubId is string && isClubAdmin(resource.data.clubId))
      );
    }

    // ── WALL COMMENTS ──────────────────────────────────────────

    match /wall_comments/{commentId} {
      allow read: if isAuthed() && resourceOnUserTeam(resource.data);
      allow create: if isAuthed()
        && request.resource.data.senderId == request.auth.uid
        && isTeamMember(request.resource.data.teamId);
      allow update, delete: if isAuthed() && (
        resource.data.senderId == request.auth.uid
        || (resource.data.clubId is string && isClubAdmin(resource.data.clubId))
      );
    }

    // ── EVENT COMMENTS ─────────────────────────────────────────

    match /eventComments/{commentId} {
      allow read: if isAuthed() && resourceOnUserTeam(resource.data);
      allow create: if isAuthed() && isTeamMember(request.resource.data.teamId);
      allow update, delete: if isAuthed() && resource.data.authorId == request.auth.uid;
    }

    // ── HELPDESK ───────────────────────────────────────────────
    // Helpdesk tickets currently aren't scoped to a club; tightening
    // would break the existing flow. Leave auth-required for now, add
    // clubId field + scope as part of phase 4.

    match /helpdeskTickets/{ticketId} {
      allow read, create: if isAuthed();
      allow update: if isAuthed() && (
        resource.data.createdBy == request.auth.uid
        || userDoc().isClubAdmin == true
      );
      allow delete: if isAuthed() && userDoc().isClubAdmin == true;
    }

    match /helpdeskComments/{commentId} {
      allow read, create: if isAuthed();
      allow update, delete: if isAuthed() && resource.data.authorId == request.auth.uid;
    }

    // ── PLAYER MEDIA / GALLERY / FULL GAMES ────────────────────
    // Public read keeps share links + the public gallery working.
    // Writes require team membership.

    match /player_media/{mediaId} {
      allow read: if true;
      allow create: if isAuthed() && isTeamMember(request.resource.data.teamId);
      allow update, delete: if isAuthed() && resourceOnUserTeam(resource.data);
    }

    match /gallery/{photoId} {
      allow read: if true;
      allow create: if isAuthed() && isTeamMember(request.resource.data.teamId);
      allow update, delete: if isAuthed() && resourceOnUserTeam(resource.data);
    }

    match /full_games/{gameId} {
      allow read: if true;
      allow create: if isAuthed() && isTeamMember(request.resource.data.teamId);
      allow update, delete: if isAuthed() && resourceOnUserTeam(resource.data);
    }

    // ── STATS / ATTENDANCE / VOLUNTEERS / DEV PLANS ────────────
    // Team-scoped reads + writes.

    match /stats/{statId} {
      allow read: if isAuthed() && resourceOnUserTeam(resource.data);
      allow create: if isAuthed() && isTeamMember(request.resource.data.teamId);
      allow update, delete: if isAuthed() && resourceOnUserTeam(resource.data);
    }

    match /development_plans/{planId} {
      allow read: if isAuthed() && resourceOnUserTeam(resource.data);
      allow create: if isAuthed() && isTeamMember(request.resource.data.teamId);
      allow update, delete: if isAuthed() && resourceOnUserTeam(resource.data);
    }

    match /attendance/{attendanceId} {
      allow read: if isAuthed() && resourceOnUserTeam(resource.data);
      allow create: if isAuthed() && isTeamMember(request.resource.data.teamId);
      allow update, delete: if isAuthed() && resourceOnUserTeam(resource.data);
    }

    match /volunteers/{volunteerId} {
      allow read: if isAuthed() && resourceOnUserTeam(resource.data);
      allow create: if isAuthed() && isTeamMember(request.resource.data.teamId);
      allow update, delete: if isAuthed() && resourceOnUserTeam(resource.data);
    }

    // ── INVITES ────────────────────────────────────────────────
    // Capability-via-URL: anyone with the unguessable id can read.
    // Writes still require auth (creating + consuming).

    match /invites/{inviteId} {
      allow read: if true;
      allow create, update, delete: if isAuthed();
    }

    match /coach_invites/{inviteId} {
      allow read: if true;
      allow create, update, delete: if isAuthed();
    }

    // ── CLUB MODULE ────────────────────────────────────────────
    // Most of these are admin-side. Public-required surfaces explicitly
    // stay open (registration form, season discovery, offer accept).
    // Everything else gated to club membership.

    // Products — public READ (registration form quotes fees).
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthed() && (
        request.resource.data.clubId is string
          ? isClubAdmin(request.resource.data.clubId)
          : isClubAdmin(resource.data.clubId)
      );
    }

    // Seasons — public READ.
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isAuthed() && (
        request.resource.data.clubId is string
          ? isClubAdmin(request.resource.data.clubId)
          : isClubAdmin(resource.data.clubId)
      );
    }

    // Registrations — public CREATE (no-auth registration form).
    // READ + admin actions require club membership.
    match /registrations/{registrationId} {
      allow create: if request.resource.data.clubId is string
        && request.resource.data.parents.size() > 0;
      allow read, update, delete: if isAuthed() && resourceOnUserClub(resource.data);
    }

    match /registration_form_configs/{configId} {
      allow read: if true;
      allow write: if isAuthed() && (
        request.resource.data.clubId is string
          ? isClubAdmin(request.resource.data.clubId)
          : isClubAdmin(resource.data.clubId)
      );
    }

    // Activities — append-only audit log. CREATE open (every part of
    // the system logs), READ to club members.
    match /activities/{activityId} {
      allow create: if true;
      allow read: if isAuthed() && (
        resource.data.clubId is string
          ? resourceOnUserClub(resource.data)
          : isAuthed() // legacy entries without clubId stay readable to all auth users
      );
      allow update, delete: if false;
    }

    // Offers — /offer/:id is no-auth public capability. READ open.
    // UPDATE limited to status fields when public, otherwise requires
    // coach/admin membership of the offering team.
    match /offers/{offerId} {
      allow read: if true;
      allow update: if (request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'respondedAt', 'declineReason', 'promotedToPlayerId', 'promotedAt', 'updatedAt']))
        || (isAuthed() && resourceOnUserClub(resource.data));
      allow create, delete: if isAuthed() && (
        request.resource.data.clubId is string
          ? isClubMember(request.resource.data.clubId)
          : isClubMember(resource.data.clubId)
      );
    }

    match /offer_templates/{templateId} {
      allow read: if isAuthed() && resourceOnUserClub(resource.data);
      allow write: if isAuthed() && (
        request.resource.data.clubId is string
          ? isClubAdmin(request.resource.data.clubId)
          : isClubAdmin(resource.data.clubId)
      );
    }

    match /form_definitions/{formId} {
      allow read: if true;
      allow write: if isAuthed() && (
        request.resource.data.clubId is string
          ? isClubAdmin(request.resource.data.clubId)
          : isClubAdmin(resource.data.clubId)
      );
    }

    match /form_signatures/{signatureId} {
      allow read: if isAuthed() && (
        // Self can read their own signatures
        resource.data.signerUid == request.auth.uid
        || (resource.data.clubId is string && isClubMember(resource.data.clubId))
      );
      allow write: if isAuthed();
    }

    match /tasks/{taskId} {
      allow read: if isAuthed() && resourceOnUserClub(resource.data);
      allow create: if isAuthed() && isClubMember(request.resource.data.clubId);
      allow update, delete: if isAuthed() && (
        resourceOnUserClub(resource.data)
      );
    }

    match /households/{householdId} {
      allow read: if isAuthed() && resourceOnUserClub(resource.data);
      allow write: if isAuthed() && (
        request.resource.data.clubId is string
          ? isClubAdmin(request.resource.data.clubId)
          : isClubAdmin(resource.data.clubId)
      );
    }

    // ── CLUBS ──────────────────────────────────────────────────
    // Public read (so the registration form can render club name etc.).
    // Writes require club admin membership. platformFeeBps mutations
    // restricted to platform owner (existing rule).

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isAuthed()
        && (!('platformFeeBps' in request.resource.data.keys()) || isPlatformOwner());
      allow update: if (isClubAdmin(clubId) || isPlatformOwner())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['platformFeeBps'])
            || isPlatformOwner());
      allow delete: if isPlatformOwner();
    }

    // ── SURVEYS ────────────────────────────────────────────────

    match /surveys/{surveyId} {
      allow read: if true;
      allow create: if isAuthed();
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount']))
        || (isAuthed() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAuthed() && resource.data.createdBy == request.auth.uid;
    }

    match /survey_responses/{responseId} {
      allow create: if request.resource.data.surveyId is string;
      allow read: if isAuthed()
        && resource.data.surveyId is string
        && get(/databases/$(database)/documents/surveys/$(resource.data.surveyId)).data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ── SUBSCRIPTIONS (placeholder for Stripe phase) ──────────
    // Written by the Stripe webhook (service-account writes bypass
    // these rules). Readable by the subscription owner only.

    match /subscriptions/{subscriptionId} {
      allow read: if isSelf(resource.data.uid) || isPlatformOwner();
      allow write: if isPlatformOwner();
    }

    // ── CATCH-ALL: DENY ────────────────────────────────────────
    // Was previously `allow read, write: if request.auth != null` which
    // silently granted access to any future collection. Flipped to deny
    // so new collections fail closed — call this out in the rules
    // PR when adding a new collection so we don't forget to add a
    // proper rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
