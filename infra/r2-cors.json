{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://firefc.app",
          "https://www.firefc.app",
          "https://goalkickr.com",
          "https://www.goalkickr.com",
          "http://localhost:3000",
          "capacitor://localhost",
          "https://localhost",
          "ionic://localhost"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
