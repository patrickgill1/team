<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- POST-SPLASH theme. Without these, Android falls back to
             its parent's defaults (DayNight in dark mode = a system
             navy/charcoal that doesn't match the brand). Result:
             splash showed correct charcoal bars, then once the React
             tree mounted and SplashScreen handed off to NoActionBar,
             the bottom gesture bar flipped to navy. Patrick caught
             it 2026-06-21: 'still has navy blue band at bottom.'
             Mirror the launch theme's color setup so both phases
             use the brand charcoal. -->
        <item name="android:statusBarColor">#0d0d10</item>
        <item name="android:navigationBarColor">#0d0d10</item>
        <item name="android:windowBackground">#0d0d10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Opt out of Android 15's forced edge-to-edge so the WebView
             doesn't draw underneath the status bar (top of the app was
             getting clipped behind the system clock) or the gesture
             nav bar (composer was sitting underneath it). Honored on
             API 35+; ignored on older Android where the WebView is
             already insetted by default. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <!-- Paint the status / nav bars and the activity window
             background with charcoal-950 (the GoalKickr brand dark)
             so the insetted strips blend into the system bars
             instead of showing the leftover Fire FC navy. Matches
             Tailwind's `charcoal.950` token = #0d0d10 and the
             runtime StatusBar.setBackgroundColor call in
             src/utils/nativeShell.ts. Patrick caught the leftover
             navy at top + bottom of a Pixel 9a on 2026-06-21. -->
        <item name="android:statusBarColor">#0d0d10</item>
        <item name="android:navigationBarColor">#0d0d10</item>
        <item name="android:windowBackground">#0d0d10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>