rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Multi-tenant + subscription helpers (Phase 2 — 2026-06-23)
    // ─────────────────────────────────────────────────────────────
    //
    // userDoc() loads the caller's user doc once per rule evaluation.
    // Used by onTeam (membership check) and hasActiveSub
    // (subscription-active check).
    //
    // Subscription enforcement: the Cloudflare worker patches
    // users/{uid}.subscriptionActive whenever Stripe fires a
    // subscription.* webhook. The flag is true for status in
    // {trialing, active} and false otherwise. Rules read this flag
    // O(0) extra reads since we're already loading userDoc.
    //
    // Roles: 'coach' and 'team_manager' are paid roles — they must
    // have an active subscription to CREATE new docs in the gated
    // collections (events, chat_messages, players, player_media,
    // gallery, full_games, live_games, practice_plans, parent_whispers,
    // wall_posts, development_plans).
    // 'parent' is free — they bypass the subscription gate so they
    // can still RSVP, reply in chat, sign forms, etc.
    // Platform admin (isClubAdmin == true) bypasses everything.
    //
    // Reads are NOT subscription-gated — a coach whose trial ended
    // can still see all their existing data.

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAuthed() {
      return request.auth != null;
    }
    function isPlatformAdmin() {
      return isAuthed() && userDoc().isClubAdmin == true;
    }
    function onTeam(teamId) {
      return isAuthed()
        && teamId is string
        && teamId in userDoc().teamIds;
    }
    function isSelf(uid) {
      return isAuthed() && request.auth.uid == uid;
    }
    function isCoachRole() {
      return isAuthed()
        && (userDoc().role == 'coach' || userDoc().role == 'team_manager');
    }
    function hasActiveSub() {
      // Worker-stamped flag. True for status in {trialing, active}.
      // Coaches without this flag can READ everything but can't
      // CREATE new content. Forces them through goalkickr.com signup.
      return isAuthed() && userDoc().subscriptionActive == true;
    }
    function canCoachWrite() {
      // The trial wall. Non-coaches (parents) and platform admin
      // bypass. Coaches must have an active subscription stamped on
      // their user doc by the Stripe webhook.
      return isPlatformAdmin() || !isCoachRole() || hasActiveSub();
    }

    // Public: anyone can read active votings (for the /vote page)
    match /match_votings/{votingId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if request.auth != null;
    }

    // Players: get is public (/vote page). LIST stays open to any
    // auth user (TODO: dozens of pages dump the full collection
    // client-side then filter; locking list breaks them all. Followup
    // audit pass to scope every query, then tighten this). CREATE +
    // delete are coach-write-gated; UPDATE allows parents to edit
    // their own kid's profile.
    match /players/{playerId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if isAuthed() && canCoachWrite()
        && onTeam(request.resource.data.teamId);
      allow update: if isAuthed() && (
        isPlatformAdmin()
        || onTeam(resource.data.teamId)
        || (resource.data.parentIds is list && request.auth.uid in resource.data.parentIds)
      );
      allow delete: if isAuthed() && (
        isPlatformAdmin()
        || (onTeam(resource.data.teamId) && canCoachWrite())
      );
    }

    // Team docs. GET restricted to actual team members. LIST stays
    // open to any auth (same followup audit as players — too many
    // pages dump the collection client-side). WRITE stays loose
    // because invite-consume / roster-join paths write arrays on
    // the team doc from the joining user's account. CREATE is
    // subscription-gated (joining an existing team doesn't need a
    // sub; spinning up a brand-new team does).
    match /teams/{teamId} {
      allow get: if isPlatformAdmin() || onTeam(teamId);
      allow list: if request.auth != null;
      allow create: if isAuthed() && canCoachWrite();
      allow update, delete: if isAuthed();
    }

    // User docs. Every authed user can read (member lookups, mentions).
    // Self-write only for general fields. CRITICAL: clients CANNOT
    // write subscriptionActive / subscriptionTier / subscriptionStatus
    // / isClubAdmin — those are platform-controlled (worker + Patrick
    // manually). Allowing client write of subscriptionActive would
    // defeat the entire trial gate.
    match /users/{userId} {
      allow read: if isAuthed();
      allow create: if isSelf(userId);
      allow update: if isAuthed() && (
        isPlatformAdmin()
        || (
          isSelf(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['subscriptionActive', 'subscriptionTier', 'subscriptionStatus', 'subscriptionUpdatedAt', 'isClubAdmin'])
        )
      );
      allow delete: if isPlatformAdmin();
    }

    match /news/{newsId} {
      allow read, write: if request.auth != null;
    }

    // Events: get is public so /event/:id share links work without
    // sign-in. LIST stays open to any auth (followup audit — many
    // pages dump events client-side then filter). Public guests can
    // RSVP via publicRsvps diff-only update. CREATE + DELETE are
    // coach-paid-gated.
    match /events/{eventId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicRsvps']))
        || (request.auth != null && (resource == null || canCoachWrite() || !isCoachRole()));
      allow create: if request.auth != null && canCoachWrite();
      allow delete: if request.auth != null && canCoachWrite();
    }

    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && canCoachWrite();
      allow update, delete: if request.auth != null;
    }

    // Chat threads — DM/group privacy when participants field is set.
    match /chat_threads/{threadId} {
      function hasParticipantsList() {
        return resource.data.participants is list;
      }
      function isPrivate() {
        return resource.data.isDM == true || resource.data.isGroup == true;
      }
      function isParticipant() {
        return request.auth != null
          && hasParticipantsList()
          && request.auth.uid in resource.data.participants;
      }
      allow read: if request.auth != null && (
        !isPrivate()
        || !hasParticipantsList()
        || isParticipant()
      );
      allow create: if request.auth != null && canCoachWrite();
      allow update: if request.auth != null && (
        !isPrivate()
        || !hasParticipantsList()
        || isParticipant()
      );
      allow delete: if request.auth != null && (
        !isPrivate()
        || !hasParticipantsList()
        || isParticipant()
      );
    }

    // Chat messages — privacy gate is at the thread layer. Parents
    // CAN send messages (no canCoachWrite check) so they can reply
    // in team chat. The trial wall applies to coaches creating NEW
    // threads (above), not posting messages in existing ones.
    match /chat_messages/{messageId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Per-message push delivery log. Worker-only writes.
    match /push_attempts/{messageId} {
      allow read: if request.auth != null
        && (resource.data.senderId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true);
      allow write: if false;
    }

    // The Wall — team-wide posts. Coach-create gated by sub.
    match /wall_posts/{postId} {
      allow read: if request.auth != null || resource.data.isPublic == true;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && canCoachWrite();
      allow update: if request.auth != null
        && (resource.data.senderId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']));
      allow delete: if request.auth != null
        && (resource.data.senderId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true);
    }

    match /wall_comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.senderId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true);
    }

    // Per-event discussion comments.
    match /eventComments/{commentId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // Helpdesk — open to any auth (not subscription gated; everyone
    // should be able to file a ticket regardless of trial state).
    match /helpdeskTickets/{ticketId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true);
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true;
    }

    match /helpdeskComments/{commentId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // Player media — was publicly readable (CRITICAL leak: kid photos
    // readable to anyone with the doc ID). Now team-scoped on read,
    // team-scoped + coach-paid-gated on create.
    match /player_media/{mediaId} {
      allow read: if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow create: if isAuthed()
        && onTeam(request.resource.data.teamId)
        && canCoachWrite();
      allow update, delete: if isAuthed() && onTeam(resource.data.teamId);
    }

    // Team gallery photos — same pattern as player_media.
    match /gallery/{photoId} {
      allow read: if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow create: if isAuthed()
        && onTeam(request.resource.data.teamId)
        && canCoachWrite();
      allow update, delete: if isAuthed() && onTeam(resource.data.teamId);
    }

    // Full-game recordings — same pattern.
    match /full_games/{gameId} {
      allow read: if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow create: if isAuthed()
        && onTeam(request.resource.data.teamId)
        && canCoachWrite();
      allow update, delete: if isAuthed() && onTeam(resource.data.teamId);
    }

    // Live games (gameday tracker) — team-scoped throughout.
    match /live_games/{gameId} {
      allow read: if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow create: if isAuthed()
        && onTeam(request.resource.data.teamId)
        && canCoachWrite();
      allow update, delete: if isAuthed() && onTeam(resource.data.teamId);
    }

    // Practice plans — team-scoped throughout.
    match /practice_plans/{planId} {
      allow read: if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow create: if isAuthed()
        && onTeam(request.resource.data.teamId)
        && canCoachWrite();
      allow update, delete: if isAuthed() && onTeam(resource.data.teamId);
    }

    // Stats records (per-game player stats). Team-scoped.
    match /stats/{statId} {
      allow read: if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow create: if isAuthed() && onTeam(request.resource.data.teamId);
      allow update, delete: if isAuthed();
    }

    // Player development plans. Team-scoped.
    match /development_plans/{planId} {
      allow read: if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow create: if isAuthed()
        && onTeam(request.resource.data.teamId)
        && canCoachWrite();
      allow update, delete: if isAuthed();
    }

    match /attendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    match /attendance_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    match /volunteers/{volunteerId} {
      allow read, write: if request.auth != null;
    }

    // Player + staff memberships (season-scoped roster pivot tables).
    // Auth required; no sub gate (these get written by invite-consume
    // flows where the joining user may not yet have an active sub).
    match /player_memberships/{membershipId} {
      allow read, write: if request.auth != null;
    }

    match /staff_memberships/{membershipId} {
      allow read, write: if request.auth != null;
    }

    // Invites — unguessable doc ID is the capability.
    match /invites/{inviteId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /coach_invites/{inviteId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ────────────────────────────────────────────────────────────
    // CLUB MODULE — registration funnel, products, offers, forms,
    // tasks, activities.
    // ────────────────────────────────────────────────────────────

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /registrations/{registrationId} {
      allow create: if request.resource.data.clubId is string
        && request.resource.data.parents.size() > 0;
      allow read, update, delete: if request.auth != null;
    }

    match /registration_form_configs/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /activities/{activityId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Offers — /offer/:id is no-auth.
    match /offers/{offerId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'respondedAt', 'declineReason', 'promotedToPlayerId', 'promotedAt', 'updatedAt'])
        || request.auth != null;
      allow create, delete: if request.auth != null;
    }

    match /offer_templates/{templateId} {
      allow read, write: if request.auth != null;
    }

    match /form_definitions/{formId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /form_signatures/{signatureId} {
      allow read, write: if request.auth != null;
    }

    match /form_submissions/{submissionId} {
      allow read, write: if request.auth != null;
    }

    // Parent Whispers — coach-private notes. Coach create requires
    // active sub (whispers are a paid feature).
    match /parent_whispers/{whisperId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && canCoachWrite();
      allow update, delete: if request.auth != null;
    }

    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    match /households/{householdId} {
      allow read, write: if request.auth != null;
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if request.auth != null
        && (!('platformFeeBps' in request.resource.data.keys())
            || request.auth.token.email == 'patrickgill4@gmail.com');
      allow update: if request.auth != null
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['platformFeeBps'])
            || request.auth.token.email == 'patrickgill4@gmail.com');
      allow delete: if request.auth != null
        && request.auth.token.email == 'patrickgill4@gmail.com';
    }

    match /surveys/{surveyId} {
      allow read: if true;
      allow create: if request.auth != null && canCoachWrite();
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount']))
        || (request.auth != null && resource.data.createdBy == request.auth.uid);
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    match /survey_responses/{responseId} {
      allow create: if request.resource.data.surveyId is string;
      allow read: if request.auth != null
        && resource.data.surveyId is string
        && get(/databases/$(database)/documents/surveys/$(resource.data.surveyId)).data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Subscription docs are read by the owning uid only. Writes are
    // always worker-only (service account bypasses these rules).
    match /subscriptions/{docId} {
      allow read: if request.auth != null && request.auth.uid == docId;
      allow write: if false;
    }

    // Catch-all: deny unknown collections by default. Anything added
    // later must get an explicit rule. Previous catch-all was
    // permissive ("any auth"), which was itself a multi-tenant leak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
