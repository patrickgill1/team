<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme-aware UIWindow underlay equivalent. Mirrors the iOS
  AppDelegate.swift dynamicProvider fix (charcoal in dark trait,
  white in light trait). Default values/ is LIGHT; values-night/
  overrides to DARK.

  Read by AppTheme.NoActionBar in styles.xml. Only affects the
  runtime window background that peeks through any WebView
  shrink (keyboard transition, bottom safe area). Launch theme
  (AppTheme.NoActionBarLaunch) intentionally stays charcoal to
  preserve the brand splash continuity.
-->
<resources>
    <!-- TEMPORARILY charcoal until light mode picker is launched to all
         users. While the JS app is force-dark for everyone (the picker
         is owner-only via isThemePickerVisible), this color must NOT be
         theme-aware — if a user's Android system trait is light, the
         WebView's transparent gaps would expose a white strip beneath
         the JS-dark UI. When the picker goes live for everyone, swap
         this back to #FFFFFF so the underlay matches the JS theme. -->
    <color name="window_background_color">#0D0D10</color>
</resources>
