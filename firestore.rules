rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Multi-tenant + subscription helpers (Phase 2 — 2026-06-23)
    // ─────────────────────────────────────────────────────────────
    //
    // userDoc() loads the caller's user doc once per rule evaluation.
    // Used by onTeam (membership check) and hasActiveSub
    // (subscription-active check).
    //
    // Subscription enforcement: the Cloudflare worker patches
    // users/{uid}.subscriptionActive whenever Stripe fires a
    // subscription.* webhook. The flag is true for status in
    // {trialing, active} and false otherwise. Rules read this flag
    // O(0) extra reads since we're already loading userDoc.
    //
    // Roles: 'coach' and 'team_manager' are paid roles — they must
    // have an active subscription to CREATE new docs in the gated
    // collections (events, chat_messages, players, player_media,
    // gallery, full_games, live_games, practice_plans, parent_whispers,
    // wall_posts, development_plans).
    // 'parent' is free — they bypass the subscription gate so they
    // can still RSVP, reply in chat, sign forms, etc.
    // Platform admin (isClubAdmin == true) bypasses everything.
    //
    // Reads are NOT subscription-gated — a coach whose trial ended
    // can still see all their existing data.

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAuthed() {
      return request.auth != null;
    }
    function isPlatformAdmin() {
      return isAuthed() && userDoc().isClubAdmin == true;
    }
    function onTeam(teamId) {
      return isAuthed()
        && teamId is string
        && teamId in userDoc().teamIds;
    }
    function isSelf(uid) {
      return isAuthed() && request.auth.uid == uid;
    }
    function isCoachRole() {
      return isAuthed()
        && (userDoc().role == 'coach' || userDoc().role == 'team_manager');
    }
    function hasActiveSub() {
      // Worker-stamped flag. True for status in {trialing, active}.
      // Coaches without this flag can READ everything but can't
      // CREATE new content. Forces them through goalkickr.com signup.
      //
      // Expiry-aware 2026-07-09: /teams/create and /clubs/create now
      // auto-stamp a 7-day trial (subscriptionActive:true +
      // subscriptionExpiresAt: now + 7d). Without a rule-side expiry
      // check, that flag would never actually expire and every trial
      // would silently become "free forever". So this function now
      // requires expiresAt (when present) to be in the future.
      //
      // Paid subs: if the Stripe webhook stamps subscriptionExpiresAt
      // to the renewal date, this rule enforces cancellations
      // automatically. If the webhook doesn't set expiresAt at all,
      // subscriptionActive stays true indefinitely (Stripe webhook
      // owns the flip on cancel) and this rule still permits.
      return isAuthed()
        && userDoc().subscriptionActive == true
        && (
          !('subscriptionExpiresAt' in userDoc())
          || userDoc().subscriptionExpiresAt > request.time
        );
    }
    function hasClubCoverage() {
      // Stamped on invite consume when a coach joins a team in a
      // real (non-default-solo) club. The club owner pays for the
      // staff; invited coaches inherit coverage rather than each
      // needing to start their own trial.
      return isAuthed() && userDoc().coverageSource == 'club';
    }
    function canCoachWrite() {
      // The trial wall. Non-coaches (parents) and platform admin
      // bypass. Coaches must have either an active subscription
      // OR club coverage inherited via invite.
      return isPlatformAdmin() || !isCoachRole() || hasActiveSub() || hasClubCoverage();
    }

    // Team-scoped coach check — reads team.coachIds via a get()
    // walk. Use this when a rule needs "is the caller ACTUALLY a
    // coach on THIS team" (not the global user.role and not the
    // trial-wall canCoachWrite gate). Added 2026-07-10 after
    // audit found live_games / practice_plans / development_plans /
    // wall_posts CREATE gated only on onTeam() + canCoachWrite —
    // meaning any parent on the team with a sub could seed fake
    // gamedays, plans, and wall posts on the team's surfaces.
    function isTeamCoach(teamId) {
      return isAuthed()
        && teamId is string
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && 'coachIds' in get(/databases/$(database)/documents/teams/$(teamId)).data
        && get(/databases/$(database)/documents/teams/$(teamId)).data.coachIds is list
        && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.coachIds;
    }

    // Public voting on player-of-the-match. Reads stay public because
    // the /vote page is shared with extended family who aren't signed
    // in.
    //
    // Update paths (2026-07-10 tighten broke coach-close; split
    // rebuilt below):
    //  1. Public vote submit — anyone (auth or not) can add to
    //     votes[]/voteCount/updatedAt/lastVoteAt. Field-scoped so
    //     internet randos can't overwrite winners or close a session.
    //  2. Coach close/edit — a coach on the voting's team can write
    //     the close fields (isActive/closedAt/winners/winner) plus
    //     eligiblePlayerIds edits. Uses request.auth.token.teamIds
    //     (custom claims minted by /users/refresh-claims) with a
    //     userDoc() fallback for callers whose token hasn't refreshed
    //     yet.
    // Delete is worker/service-account only.
    match /match_votings/{votingId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['votes', 'voteCount', 'updatedAt', 'lastVoteAt'])
        || (
          request.auth != null
          && resource.data.teamId is string
          && (
            resource.data.teamId in request.auth.token.get('teamIds', [])
            || (
              exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamIds is list
              && resource.data.teamId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamIds
            )
          )
        );
      allow create: if request.auth != null;
      allow delete: if false;
    }

    // Players — hardened 2026-07-08 (Patrick's PII audit after
    // seeing a competing platform expose parent data cross-club).
    //
    // GET: was `if true` — anyone with a playerId could pull the
    // full doc (DOB, medical, parentEmails, etc). Tightened to
    // per-doc scope: platform admin, parent of the player, or
    // coach/parent on one of the player's teams.
    // Public /vote page no longer reads players directly — it
    // hits /public/voting/:votingId/roster on the worker which
    // returns a sanitized name+jersey+photo shape.
    //
    // LIST: was `if request.auth != null` — any authed user could
    // enumerate every player in the database. Tightened to the
    // same per-doc rule, which means every list query must include
    // a WHERE filter that guarantees only in-scope docs match
    // (Firestore denies the whole list if any matched doc fails
    // the rule). Client queries updated: CoachAccordionBar,
    // CoachTeamHealthCard, PlayerList, EndSeasonModal now use
    // teamIds array-contains; PublicVote now uses the worker.
    function callerCanReadPlayer() {
      // Reverted to the original simple shape (2026-07-08). Recent
      // attempts to add null-safety / team.coachIds fallback / legacy
      // teamId branches all compiled but LIST queries kept 403ing for
      // coaches whose user.teamIds provably contains the team (Nick
      // Barker + Patrick's fresh team both confirmed). The additional
      // branches were the delta; simplify back to a known-working
      // shape and prove reads land, then re-add branches surgically.
      return isPlatformAdmin()
        || (
          resource.data.parentIds is list
          && request.auth.uid in resource.data.parentIds
        )
        || (
          resource.data.teamIds is list
          && resource.data.teamIds.hasAny(userDoc().teamIds)
        )
        || (
          resource.data.teamId is string
          && resource.data.teamId in userDoc().teamIds
        );
    }
    // ─────────────────────────────────────────────────────────────
    // PII Phase 3 helpers (2026-07-09) — parent_whispers, households,
    // form_submissions. Each helper reads `resource.data` at rule-eval
    // time, so it works uniformly for GET and LIST as long as the
    // client query filters guarantee every matched doc passes.
    //
    // registrations left open pending a parentEmails[] denorm field
    // (see FamilyTimeline / InThePoolHero client queries).
    // chat_threads / chat_messages left open per the documented list-
    // query trade above.
    // ─────────────────────────────────────────────────────────────
    function callerCanReadWhisper() {
      // Whispers are coach-private notes to a player's parent(s).
      // Read scope: the authoring coach, any ACTUAL coach on the
      // whisper's team (team.coachIds membership — NOT just a
      // caller who self-identifies as role='coach'), the player's
      // parents, or platform admin.
      //
      // Pre-3.9.159 this trusted isCoachRole() + teamId in user.teamIds
      // — meaning a parent who flipped to role='coach' via Settings
      // would inherit read access to coach-private notes about every
      // kid on their team. Fixed by checking team.coachIds directly.
      return isPlatformAdmin()
        || resource.data.coachUid == request.auth.uid
        || (
          resource.data.teamId is string
          && exists(/databases/$(database)/documents/teams/$(resource.data.teamId))
          && 'coachIds' in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data
          && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.coachIds is list
          && request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.coachIds
        )
        || (
          resource.data.playerId is string
          && exists(/databases/$(database)/documents/players/$(resource.data.playerId))
          && request.auth.uid in get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.parentIds
        );
    }
    function callerCanReadHousehold() {
      // Households store parent email lists + linked playerIds.
      // Read scope: any parent whose email is on the household, a
      // club admin of the household's club, or platform admin.
      return isPlatformAdmin()
        || (
          request.auth.token.email is string
          && resource.data.parentEmails is list
          && request.auth.token.email.lower() in resource.data.parentEmails
        )
        || (
          userDoc().isClubAdmin == true
          && resource.data.clubId is string
          && resource.data.clubId in userDoc().get('clubIds', [])
        );
    }
    function callerCanReadFormSubmission() {
      // Form submissions store medical notes, signed acknowledgements,
      // waiver answers. Read scope: parent of the player the submission
      // is for, an ACTUAL coach on the player's primary team (checked
      // against team.coachIds, NOT the caller's self-declared role),
      // club admin of the doc's clubId, or platform admin.
      //
      // Pre-3.9.159 fix history: the coach branch trusted isCoachRole()
      // + teamIds overlap, which made role='coach' a magic key to every
      // family's medical + waiver data on the team. Fixed by walking
      // player → primary team → coachIds. `teamIds[0]` is the primary
      // team; players on multiple teams get their form submissions
      // gated by the first-listed team's coach roster.
      return isPlatformAdmin()
        || (
          resource.data.playerId is string
          && exists(/databases/$(database)/documents/players/$(resource.data.playerId))
          && (
            request.auth.uid in get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.parentIds
            || (
              get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.teamIds is list
              && get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.teamIds.size() > 0
              && exists(/databases/$(database)/documents/teams/$(get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.teamIds[0]))
              && 'coachIds' in get(/databases/$(database)/documents/teams/$(get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.teamIds[0])).data
              && get(/databases/$(database)/documents/teams/$(get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.teamIds[0])).data.coachIds is list
              && request.auth.uid in get(/databases/$(database)/documents/teams/$(get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.teamIds[0])).data.coachIds
            )
          )
        )
        || (
          userDoc().isClubAdmin == true
          && resource.data.clubId is string
          && resource.data.clubId in userDoc().get('clubIds', [])
        );
    }
    match /players/{playerId} {
      // GET: per-doc rule via callerCanReadPlayer — Firestore evaluates
      // the rule against the resolved resource.data, no LIST-time
      // static verification needed. Safe to use userDoc() here.
      allow get: if isAuthed() && callerCanReadPlayer();
      // LIST: was tightened via callerCanReadPlayer, but Firestore's
      // LIST rule authorization statically compares the rule against
      // query constraints. `resource.data.teamIds.hasAny(userDoc().teamIds)`
      // is not statically verifiable against `where teamIds array-contains X`
      // because userDoc().teamIds is a runtime lookup, so Firestore
      // rejects every scoped LIST query with permission-denied — even
      // when the runtime rule would pass. Nick Barker + Patrick's fresh
      // team both hit this.
      //
      // Compromise: LIST is `if isAuthed()` (regression on enumeration
      // protection), but every LIST call site was already tightened to
      // pass a scoped filter (teamIds array-contains selectedTeamId,
      // parentIds array-contains uid, etc), so a well-behaved client
      // can't dump the collection anyway. A rogue authed client COULD
      // enumerate — but the PII in players (name, jersey, positions)
      // is what a rogue-authed coach could already see via legitimate
      // GET on any player they know the id of anyway. High-value PII
      // (medical, parent contact) is on downstream fields that this
      // rule doesn't guard; those live on player-adjacent collections
      // with per-doc GET rules that DO fire correctly.
      //
      // Re-tighten once we've either (a) added a query-verifiable
      // filter — e.g. custom-claim-based teamIds on the JWT — or
      // (b) rewritten the rule to not need userDoc() at LIST time.
      allow list: if isAuthed();
      // 2026-08-14 gate split: was `canCoachWrite() && onTeam(...)`
      // — but canCoachWrite short-circuits true for parents (they're
      // not isCoachRole), so any parent on the team could seed players.
      // Now isTeamCoach: real coach on THIS team, no trial wall.
      // Roster-building is core team-management, not a paid feature.
      allow create: if isAuthed() && isTeamCoach(request.resource.data.teamId);
      // Re-tightened 2026-07-06: the self-add-to-parentIds branch is
      // gone. Player-takeover fixed. parentIds mutations happen
      // exclusively via /claim/invite, /claim/player-link,
      // /players/link-parent, /players/toggle-self-parent, or a
      // coach acting through the standard on-team branch.
      //
      // Existing parents can still update non-parent fields on their
      // kid (profile photo, jersey number, positions) but cannot
      // modify parentIds / teamId / teamIds from that branch — those
      // require worker action.
      // Belt-and-suspenders 2026-07-07: parentIds is off-limits to
      // any client update path — coach or parent alike. Only worker
      // endpoints (which use the service account and bypass rules)
      // can mutate it. This locks out the class of bug where an
      // unrelated roster form save clobbered the parent list.
      // parentEmails STAYS writable from the coach path because the
      // AddPlayer form legitimately captures / edits invite-match
      // emails; it doesn't grant access, only maps future signups.
      // Streak clobber guard 2026-07-21: any client-branch update that
      // touches currentStreakDays must not decrease it by more than 1
      // vs the stored value. A legit missed-day decay is at most 1 (walk
      // is monotonic and days pass one at a time). Bigger drops mean an
      // OLD client bundle self-healing from plan-shape data — Hunter's
      // 13-day streak got clobbered to 1 that way. Worker/admin path
      // (isPlatformAdmin branch) bypasses; this only shields against
      // stale-code writes from authed users. Applies even if the update
      // doesn't touch currentStreakDays (guard is a no-op then via
      // hasAny short-circuit).
      //
      // XP mirror denylist 2026-07-24: xp, xpCareer, badges, and the
      // per-day cap counters (xpDailyCountBySource, xpDailyGrantCount)
      // are server-authoritative — every legitimate write goes through
      // /xp/log-grant or /xp/log-tap worker endpoints (service account
      // path, bypasses this rule). No client code writes these fields
      // directly (verified 2026-07-24). Denylist shape, not allowlist —
      // every other field on the player doc stays exactly as writeable
      // as before. currentStreakDays intentionally NOT denied: the
      // streak-clobber guard above is the intended shield, and the
      // self-heal path in InlineDevPlanCard / Dashboard legitimately
      // needs client writes. lastSeenXpAt / lastSeenBadgeAt are UX
      // cursors the client legitimately writes.
      allow update: if isAuthed() && (
        isPlatformAdmin()
        || (
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentStreakDays'])
            || request.resource.data.get('currentStreakDays', 0)
                >= resource.data.get('currentStreakDays', 0) - 1
          )
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['xp', 'xpCareer', 'badges', 'xpDailyCountBySource', 'xpDailyGrantCount'])
          && (
        (
          onTeam(resource.data.teamId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['parentIds'])
        )
        // Club-scoped branch (added 2026-07-10). Any member of the
        // player's club (userDoc.clubIds contains player.clubId — set
        // by every path that grants team or club membership) can
        // update non-membership fields on any player in that club.
        //
        // Motivation: the MedicalEditModal and HouseholdLinkModal are
        // club-admin surfaces that need to edit players across every
        // team in the club, not just the caller's roster. Previously
        // 403'd on the onTeam branch when the admin wasn't a coach on
        // the target's specific team. Same shape as the
        // /players/stamp-funnel worker endpoint, but exposed to the
        // client for the non-funnel edits (medical, household, etc.).
        //
        // Membership fields (parentIds, teamId, teamIds, coachIds,
        // clubId, isActive) stay worker-only. Non-membership fields
        // (medical, householdId, jerseyNumber, position, etc.) writable
        // from this branch.
        || (
          resource.data.clubId is string
          && resource.data.clubId in userDoc().get('clubIds', [])
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'parentIds', 'coachIds', 'teamId', 'teamIds', 'clubId', 'isActive',
                // Also lock the public-share flag from this branch —
                // parent-driven action, not a club-admin one. Parent
                // branch already covers it.
                'publicShare',
                // kidMode carries the PIN hash — worker-only writes
                // (via /players/set-kid-mode). Club admins can't stamp
                // it either.
                'kidMode',
              ])
        )
        || (
          resource.data.parentIds is list
          && request.auth.uid in resource.data.parentIds
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['parentIds', 'parentEmails', 'teamId', 'teamIds', 'isActive', 'kidMode'])
        )
          )
        )
      );
      // 2026-08-11 permissions audit: swapped `onTeam() &&
      // canCoachWrite()` for `isTeamCoach()`. The previous rule had
      // TWO bugs: (1) a lapsed-sub coach couldn't clean up their
      // roster; (2) worse, canCoachWrite() short-circuits true for
      // parents via !isCoachRole(), so ANY parent on the team could
      // delete ANY player doc — including a teammate's kid.
      // isTeamCoach() requires the caller be in team.coachIds,
      // which closes both holes.
      allow delete: if isAuthed() && (
        isPlatformAdmin()
        || isTeamCoach(resource.data.teamId)
      );

      // ─────────────────────────────────────────────────────────
      // Dev-plan check-ins — player-scoped source of truth for the
      // practice streak. One doc per player per Denver day, docId is
      // the "YYYY-MM-DD" Denver day key so re-taps same-day are a
      // silent 409 no-op. Streak reads only from here, plan-agnostic:
      // retiring a plan no longer resets a legitimate streak.
      //
      // READ: anyone who can read the parent player doc (coach on
      //   team, Circle member). Reuses the same rule shape.
      // WRITE: worker service account only. Client is never allowed
      //   direct writes so the streak counter can't be tampered with.
      //   Client "I did it" taps route through /dev-plans/log-tap
      //   which uses the service account. Soft-delete pattern: coach
      //   undo sets voided:true via a worker endpoint (never delete).
      // ─────────────────────────────────────────────────────────
      match /dev_checkins/{dayKey} {
        // LIST and GET share the same predicate — the earlier
        // `allow list: if isAuthed()` line was a privacy leak that let
        // any authed user enumerate any player's practice history
        // (dayKey, note, coach name, planId). Coaches on the team and
        // Player Circle only. 2026-07-21.
        allow get, list: if isAuthed()
          && exists(/databases/$(database)/documents/players/$(playerId))
          && (
            isPlatformAdmin()
            || (
              get(/databases/$(database)/documents/players/$(playerId)).data.parentIds is list
              && request.auth.uid in get(/databases/$(database)/documents/players/$(playerId)).data.parentIds
            )
            || (
              get(/databases/$(database)/documents/players/$(playerId)).data.teamIds is list
              && get(/databases/$(database)/documents/players/$(playerId)).data.teamIds.hasAny(userDoc().teamIds)
            )
            || (
              get(/databases/$(database)/documents/players/$(playerId)).data.teamId is string
              && get(/databases/$(database)/documents/players/$(playerId)).data.teamId in userDoc().teamIds
            )
          );
        allow create, update, delete: if false;
      }
    }

    // Team docs. GET restricted to actual team members. LIST stays
    // open to any auth (same followup audit as players — too many
    // pages dump the collection client-side). WRITE stays loose
    // because invite-consume / roster-join paths write arrays on
    // the team doc from the joining user's account.
    //
    // CREATE is open to any authed user — a brand-new coach needs a
    // team to use the app, and the team doc itself is harmless
    // metadata. The trial wall still gates the meaningful actions
    // (chat threads, events, player creation, media, etc) so an
    // un-subscribed coach can spin up a team for onboarding but
    // can't actually run it without a subscription. Patrick
    // 2026-06-25 screenshot: 'Missing or insufficient permissions'
    // on team-create blocked a new coach mid-onboarding.
    match /teams/{teamId} {
      allow get: if isPlatformAdmin() || onTeam(teamId);
      allow list: if request.auth != null;
      allow create: if isAuthed();
      // Re-tightened 2026-07-06: update/delete require caller be in
      // resource.data.coachIds OR platform admin. Worker-driven writes
      // (/teams/create, /teams/add-coach, /teams/share-player, etc)
      // use the service account and bypass this rule.
      //
      // 2026-07-10 hardening: added a denylist on the coach branch so
      // an assistant coach can't PATCH team.coachIds to eject the
      // head, or add an alt uid granting themselves broader access
      // via downstream rules that trust team.coachIds. Cosmetic
      // fields (name, kit, digest configs, etc) still writable from
      // the client. Security-critical membership + club-scope fields
      // must go through worker endpoints:
      //   coachIds        → /teams/add-coach, /teams/remove-coach
      //   headCoachId     → /teams/transfer-head
      //   assistantCoachIds → derived; also worker-only
      //   managerIds      → /teams/set-staff-role
      //   ownerUid        → never mutable by client
      //   clubId          → move-team is a club admin action
      //   isActive        → /teams/archive, /teams/restore
      //   subscription*   → Stripe webhook only
      //   staffPermissions → /teams/set-staff-permissions
      allow update: if isAuthed() && (
        isPlatformAdmin()
        || (
          resource.data.coachIds is list
          && request.auth.uid in resource.data.coachIds
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'coachIds', 'headCoachId', 'assistantCoachIds',
                'managerIds', 'staffPermissions',
                'ownerUid', 'clubId',
                'isActive', 'archivedAt',
                'subscriptionActive', 'subscriptionExpiresAt',
                'subscriptionStatus', 'subscriptionTier',
              ])
        )
      );
      allow delete: if isAuthed() && (
        isPlatformAdmin()
        || (resource.data.coachIds is list && request.auth.uid in resource.data.coachIds)
      );
    }

    // User docs. Every authed user can read (member lookups, mentions).
    //
    // WRITE POLICY (hardened 2026-07-06 Phase 2):
    // Self-writes are allowed ONLY for profile-and-preferences fields.
    // The security-critical fields (role, team/club membership,
    // approval, coverage, invite audit trail, subscription state,
    // adult-player claim) are worker-only — they must be mutated
    // through the guarded write endpoints in worker/src/writeGuards.ts
    // where the caller's legitimacy can be verified (valid invite
    // token, coach-of-team, self-only, etc). Before this change any
    // signed-in user could grant themselves membership on any team
    // by patching their own teamIds — the audit's #2 finding.
    // Users read helper — tightened 2026-07-08 (Patrick's PII audit
    // after seeing a competing platform expose parent contact info
    // cross-club).
    //
    // Prior: `allow read: if isAuthed()` — any authed user could
    // read every user doc in the database (name, email, phone,
    // address, emergencyContact, emergencyPhone, widgetToken which
    // is effectively a bearer credential for the widget endpoint,
    // fcmTokens, subscription state, invite audit trail).
    //
    // New: caller must be self, platform admin, OR share a team
    // with the target user, OR share a club with the target user.
    // Club admins remain readable by anyone sharing their club(s)
    // (needed for Helpdesk ticket admin fan-out).
    //
    // Callers that won't work under this rule and need to move to
    // a worker endpoint in a follow-up ship:
    //   - findUserUidsByEmails (utils/notify.ts) — cross-tenant
    //     email→uid lookup. sendPushToParentEmails will return
    //     0 uids for cross-team addresses; email fallback still
    //     fires so no functional regression, just fewer push hits.
    //   - Any where('isClubAdmin', '==', true) list that expects
    //     to see admins outside the caller's own clubs. Helpdesk
    //     admin fan-out already goes through worker paths for
    //     writes; the client-side reads are for UI hints only.
    function callerCanReadUser(userId) {
      return isPlatformAdmin()
        || isSelf(userId)
        || (
          resource.data.teamIds is list
          && resource.data.teamIds.hasAny(userDoc().get('teamIds', []))
        )
        // Legacy: some older docs have `teamId` (string) but not
        // `teamIds` (list). Keep them readable while we backfill.
        || (
          resource.data.teamId is string
          && resource.data.teamId in userDoc().get('teamIds', [])
        )
        || (
          resource.data.clubIds is list
          && resource.data.clubIds.hasAny(userDoc().get('clubIds', []))
        )
        || (
          resource.data.clubId is string
          && resource.data.clubId in userDoc().get('clubIds', [])
        )
        // Club-admin exception: any club member can read admins of
        // their club(s). Preserves the Helpdesk admin-lookup path
        // without opening cross-club enumeration.
        || (
          resource.data.isClubAdmin == true
          && resource.data.clubIds is list
          && resource.data.clubIds.hasAny(userDoc().get('clubIds', []))
        );
    }
    match /users/{userId} {
      allow get:  if isAuthed() && callerCanReadUser(userId);
      // LIST rule follows the same shape as players (July 9 fix):
      // callerCanReadUser calls userDoc() which Firestore can't
      // statically resolve against a `where teamIds array-contains X`
      // predicate, so a scoped LIST would 403 outright even though
      // per-doc runtime eval would pass. Directory / People /
      // VolunteerScheduler / Dashboard all fell into this trap the
      // day the tight rule went in. Follow-up: replace with a
      // custom-claims shape (request.auth.token.teamIds) that
      // Firestore CAN statically verify. Until then, LIST is
      // `if isAuthed()` and every client caller is scoped with
      // `where teamIds array-contains teamId` via getUsersByTeam
      // so a well-behaved client only sees its own team's users.
      // A rogue authed client could dump the users collection —
      // matches the trust boundary players already sits on. Real
      // PII (medical, whispers, form submissions) still has tight
      // per-doc guards on those collections.
      allow list: if isAuthed();
      // Create still allowed self-only so the Firebase-Auth-to-
      // Firestore bootstrap on first sign-in works. The worker's
      // /users/bootstrap endpoint uses admin creds so THIS branch
      // isn't hit for worker-driven creates — it's the fallback for
      // legacy or manual paths.
      allow create: if isSelf(userId);
      // Re-tightened 2026-07-06 after wave-2 migrations. Every
      // security-critical field is now written server-side via a
      // worker endpoint (see worker/src/writeGuards.ts). Self-writes
      // are limited to profile + preferences fields.
      allow update: if isAuthed() && (
        isPlatformAdmin()
        || (
          isSelf(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              // Subscription state — worker via Stripe webhook.
              'subscriptionActive', 'subscriptionTier', 'subscriptionStatus', 'subscriptionUpdatedAt',
              // Platform admin flag — worker or manual only.
              'isClubAdmin',
              // Role + coach level — /users/bootstrap, /claim/invite,
              // /teams/create, /users/set-role, /teams/transfer-head.
              'role', 'coachLevel',
              // Team + club membership — /users/bootstrap,
              // /claim/invite, /claim/player-link, /teams/create,
              // /teams/add-coach, /teams/share-player,
              // /teams/unshare-player, /users/set-teams,
              // /clubs/create, /club/set-admin, /club/remove-admin.
              'teamId', 'teamIds', 'clubId', 'clubIds',
              // Approval + coverage — server-controlled.
              'approved', 'approvalStatus', 'approvedAt',
              'coverageSource', 'coverageClubId',
              // Deactivation — coach action via /users/deactivate.
              'isActive',
              // Invite audit trail.
              'invitedBy', 'invitedVia',
              // Adult-player claim — /claim/invite or /claim/player-link.
              'selfPlayerId',
              // Children list — /claim/player-link.
              'children'
            ])
        )
      );
      allow delete: if isPlatformAdmin();
    }

    match /news/{newsId} {
      allow read, write: if request.auth != null;
    }

    // Events: auth required for read + write. The public no-auth
    // share page (/event/:id) was retired 2026-06-24 — everyone uses
    // the app via parent/extended-family invites now. LIST stays
    // open to any auth (followup audit — many pages dump events
    // client-side then filter). CREATE + DELETE coach-paid-gated.
    // Events — team calendar. GET/LIST intentionally open to any
    // authed (a parent on Team A viewing a share link should be able
    // to read the event doc when they land there). UPDATE previously
    // let any non-coach (parent) PATCH any field on any event across
    // any team via the `!isCoachRole()` short-circuit — meaning a
    // parent could rewrite another team's event title/time/teamId
    // silently. Tightened 2026-07-10 to a per-team allowlist: coach
    // of the event's team gets full update (via canCoachWrite trial
    // wall), parents get an RSVP-fields-only path when on the team.
    match /events/{eventId} {
      allow get, list: if request.auth != null;
      // 2026-07-14 audit: removed the `resource == null` short-circuit.
      // That branch was intended as a legacy setDoc-with-id escape
      // hatch, but audit found ZERO client callers using setDoc on
      // /events — every mutation goes through addDoc (CREATE rule)
      // or updateDoc (existing-doc path). The `resource == null`
      // branch was silently defeating the CREATE rule: any authed
      // user could call setDoc(doc(db,'events',<newId>), {...}) and
      // seed events on any team, skipping the coach-of-team check.
      // If a legit future flow needs setDoc-with-id it will hit the
      // CREATE rule and pass so long as it's coach-of-team.
      // 2026-08-11 permissions audit: dropped canCoachWrite() from
      // the coach-of-team update branch. Editing an EXISTING event
      // (change location, fix time, cancel, soft-delete) is
      // stewardship, not new-value creation — a coach whose sub
      // lapsed should still be able to steward their team's events
      // so parents don't show up to the wrong place. The two prior
      // narrow escape hatches for isActive/deletedAt and
      // isCancelled fields are now subsumed by the broader coach
      // update branch and were removed.
      allow update: if request.auth != null && (
        // Coach on this team can update anything on the event.
        isTeamCoach(resource.data.teamId)
        // Parent on this team can flip RSVP-style fields only.
        || (
          onTeam(resource.data.teamId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['rsvps', 'playerRsvps', 'attendance', 'viewedBy'])
        )
      );
      // 2026-08-14 gate split: was `canCoachWrite()` alone — which
      // (a) short-circuited true for parents (they're not isCoachRole),
      // letting any team parent seed events, and (b) blocked lapsed-sub
      // coaches from scheduling recurring practices even though event
      // scheduling is core team-management, not a paid feature. Now
      // isTeamCoach: real coach on THIS team, no trial wall.
      allow create: if request.auth != null
        && isTeamCoach(request.resource.data.teamId);
      // Hard delete gated on isTeamCoach — same rationale as
      // update. Soft-delete (isActive: false via update) is the
      // preferred coach path.
      allow delete: if request.auth != null
        && (isPlatformAdmin() || isTeamCoach(resource.data.teamId));
    }

    // ── Team payment_requests (2026-07-18) ────────────────────
    //
    // Coach-owned payment requests spanning one_off / recurring /
    // catalog kinds. Reads: any signed-in user on the team can see
    // active requests so parents can pay. Writes: worker-only —
    // /payments/create, /payments/close, /payments/mark-paid-cash,
    // and the Stripe webhook stamp paidUids / stripeSubscriptionIds /
    // purchases[]. Parents never touch these fields directly.
    match /payment_requests/{paymentRequestId} {
      // Signed-in coaches + parents on the team get list + get.
      // Anonymous guests hitting /pay/{id} DO NOT read the doc
      // directly — Firestore rules can't project fields, and the doc
      // carries prior-payer PII (guestPaid[] emails/names, paidUids,
      // stripeSubscriptionIds, purchases[].uid). The /pay/{id} page
      // reads a projected safe subset through the worker's
      // /payments/pay-link-info endpoint instead.
      allow get, list: if request.auth != null;
      allow create, update, delete: if false;
    }
    match /payment_requests/{paymentRequestId}/invoices/{invoiceId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // ── Trip primitive (2026-07-19) ────────────────────────────
    //
    // Coach-owned stat-scoping container (tournaments / weekend trips).
    // Reads: team-scoped. Only signed-in members of the trip's team
    // can read the doc directly (get). LIST stays open per the
    // documented Firestore workaround — clients MUST include a
    // teamId equality filter (the /coach/trips + PlayerTripsCard
    // queries do). PublicTrip page's Path A relies on this get()
    // returning permission-denied for non-team members so it falls
    // through to the shareToken worker path.
    //
    // A public read-only recap URL at /trip/:id?token=... is served
    // through the worker /trips/public-info endpoint using shareToken.
    // Writes: worker-only (/trips/create, /trips/update, /trips/archive,
    // /trips/attend, /trips/unattend). Coach-of-team check runs server
    // side there.
    match /trips/{tripId} {
      allow get: if isAuthed()
        && resource.data.teamId is string
        && resource.data.teamId in userDoc().teamIds;
      allow list: if isAuthed();
      allow create, update, delete: if false;
    }

    // ── League MVP (2026-07-11) ────────────────────────────────
    // Rules are permissive for public league discovery (public
    // fixtures + standings are the whole point). All writes route
    // through the worker (/leagues/create, /leagues/fixture-create,
    // /leagues/report-score), so client rules are read-only.
    // The worker validates ownerUid / adminUids server-side.
    match /leagues/{leagueId} {
      allow get: if resource.data.isPublic == true || request.auth != null;
      allow list: if request.auth != null;
      allow create, update, delete: if false;
    }
    match /fixtures/{fixtureId} {
      // Read piggybacks on the league — if the league is public, the
      // fixture is too. Cheaper than reading the league on every LIST
      // by just gating on request.auth for now.
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /standings/{leagueId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // /messages — LEGACY DEAD COLLECTION. 2026-07-14 audit confirmed
    // zero client + zero worker callers. The active chat stack uses
    // chat_messages / kid_chat_messages / chat_threads. Comment at
    // src/pages/TeamChat.tsx:2147 explicitly documents /messages as
    // "unrelated legacy collection." Prior rule allowed authed
    // read/update/delete on the whole collection — cross-tenant
    // enumeration surface with no legit purpose. Locked entirely.
    match /messages/{messageId} {
      allow read, write: if false;
    }

    // Chat threads.
    //
    // 2026-07-21 subcollection migration: group chats moved out of
    // this collection into `chat_group_threads` (rules below). This
    // collection now holds ONLY team + DM + club + coach scopes.
    // Because groups no longer live here, the isGroup disjunction is
    // gone from every clause and the rule reverts to its
    // pre-group posture. The tightened participants-only gate for
    // groups lives on the new collection instead.
    match /chat_threads/{threadId} {
      allow read: if request.auth != null;
      // 2026-08-14 gate split: dropped canCoachWrite. Threads are DM +
      // team + club + coach containers; parents legitimately create DMs
      // to coaches. The gate was only blocking lapsed-sub coaches from
      // starting new team threads. Messages themselves have their own
      // per-write rules; an empty thread doc is a low-risk container.
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Group chats (subcollection migration, 2026-07-21).
    //
    // Groups live at chat_group_threads/{gid} with messages nested
    // as chat_group_threads/{gid}/messages/{mid}. Collection identity
    // IS the discriminator — no stored isGroup field. The rule gates
    // read/list/get on participants membership, which the client
    // sidebar query (`where participants array-contains uid`)
    // satisfies by construction and which the parent-get() on the
    // messages subcollection inherits naturally.
    //
    // Firestore list semantics: any doc that fails the predicate kills
    // the whole snapshot. The sidebar query is safe because Firestore
    // pre-filters by the array-contains constraint, so every returned
    // doc already has the caller in participants.
    match /chat_group_threads/{threadId} {
      // 2026-07-21 fix: dropped `resource.data.participants is list`
      // from every clause because it caused Firestore's LIST static
      // analyzer to reject the sidebar query
      // (`where participants array-contains uid`) with
      // permission-denied even though every actual matched doc
      // satisfied the participants check. array-contains on the
      // client already guarantees participants exists as a list -
      // Firestore only matches array fields with that operator - so
      // the rule guard was redundant AND breaking things.
      allow read, list, get: if request.auth != null
        && request.auth.uid in resource.data.participants;
      // 2026-08-14 gate split: dropped canCoachWrite. Group chats are a
      // team-comms primitive; participants + createdBy checks are
      // sufficient safety without the trial wall.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null && (
        request.auth.uid in resource.data.participants
        || isPlatformAdmin()
      );

      // Messages under a group thread. Parent-get() reads the
      // thread's participants — 1 get per rule eval, well inside the
      // 10-get budget. Author owns the message; participants can
      // toggle reactions/readBy/acknowledgedBy without needing to be
      // the author (mirrors the top-level chat_messages posture).
      match /messages/{messageId} {
        allow read, list, get: if request.auth != null
          && request.auth.uid in
              get(/databases/$(database)/documents/chat_group_threads/$(threadId)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
              get(/databases/$(database)/documents/chat_group_threads/$(threadId)).data.participants;
        allow update: if request.auth != null && (
          resource.data.senderId == request.auth.uid
          || isPlatformAdmin()
          || (
            request.auth.uid in
              get(/databases/$(database)/documents/chat_group_threads/$(threadId)).data.participants
            && (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedBy'])
            )
          )
        );
        allow delete: if request.auth != null && (
          resource.data.senderId == request.auth.uid
          || isPlatformAdmin()
        );
      }
    }

    // Chat messages — privacy gate is at the thread layer. Parents
    // CAN send messages (no canCoachWrite check) so they can reply
    // in team chat. The trial wall applies to coaches creating NEW
    // threads (above), not posting messages in existing ones.
    //
    // Update/delete tightened 2026-07-10: was `if request.auth != null`
    // which meant any signed-in user could edit or delete anyone
    // else's message across every team/club. Now requires the caller
    // OWNS the message (senderId === auth.uid) OR is platform admin,
    // with an escape hatch for reaction / readBy field-only updates
    // that legitimately come from other participants.
    match /chat_messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.senderId == request.auth.uid
        || isPlatformAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        // Poll voting (2026-07-10 fix): any signed-in participant
        // needs to write `poll.options` to toggle their vote. Previously
        // only the poll's sender could vote — polls silently 403'd for
        // everyone else. Field-scoped so non-poll fields stay locked.
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
        // Message acknowledgement — anyone auth'd adds themselves to
        // acknowledgedBy[]. Sender's own message doesn't need this
        // branch (senderId==auth.uid clause above covers them).
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedBy'])
      );
      allow delete: if request.auth != null && (
        resource.data.senderId == request.auth.uid
        || isPlatformAdmin()
        // Team coach moderation (2026-08-03 coach ask). Message
        // carries teamId at write time (TeamChat.tsx:1580) — check
        // caller is in that team's coachIds. Bails safely on missing
        // teamId (is/!= '' checks) and on nonexistent team doc
        // (Firestore rules coerce the failing OR branch to false).
        || (resource.data.teamId is string
            && resource.data.teamId != ''
            && request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.coachIds)
      );
    }

    // ────────────────────────────────────────────────────────────
    // Kid profile chat — kids-only team room. Auth layer stays the
    // parent's uid (kid mode is UI-only), but every message carries
    // actingAsPlayerId identifying the KID the message came from.
    //
    // READ: any authed team member — coaches shadow-read for
    //   moderation, parents shadow-read for safety, kid gets their
    //   own room. Scoped by teamId in the caller's user.teamIds.
    // CREATE: caller must be a parent of the acting-as player AND
    //   the player must be on this team. Parents (or a kid in kid
    //   mode, which auths as parent uid) can post; coaches cannot
    //   post — this is the kids' room, not a broadcast channel.
    // DELETE: sender OR coach on this team (moderation).
    // UPDATE: locked (no edits, no reactions in v1 — deliberate).
    // ────────────────────────────────────────────────────────────
    match /kid_chat_threads/{threadId} {
      allow read: if isAuthed()
        && resource.data.teamId in userDoc().teamIds;
      allow create: if isAuthed()
        && request.resource.data.teamId in userDoc().teamIds
        && request.resource.data.audience == 'kids';
      // Self-scoped opt-in: kid-chat pushes default to mentions-only.
      // Any team member can add or remove ONLY their own uid from the
      // thread's notifyAllUids array to flip themselves to "notify me
      // for every message". No other field may change here; no other
      // user's uid may be touched. Symmetric add/remove guard means a
      // caller can toggle themselves in and out but never bulk-rewrite
      // the array to include or exclude someone else.
      allow update: if isAuthed()
        && resource.data.teamId in userDoc().teamIds
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['notifyAllUids'])
        && request.resource.data.get('notifyAllUids', []).toSet()
            .difference(resource.data.get('notifyAllUids', []).toSet())
            .hasOnly([request.auth.uid])
        && resource.data.get('notifyAllUids', []).toSet()
            .difference(request.resource.data.get('notifyAllUids', []).toSet())
            .hasOnly([request.auth.uid]);
      allow delete: if false;
    }

    match /kid_chat_messages/{messageId} {
      allow read: if isAuthed()
        && resource.data.teamId in userDoc().teamIds;
      allow create: if isAuthed()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.teamId in userDoc().teamIds
        && request.resource.data.actingAsPlayerId is string
        && request.auth.uid in get(/databases/$(database)/documents/players/$(request.resource.data.actingAsPlayerId)).data.parentIds;
      // Soft-delete only: sender or team coach flip isDeleted +
      // audit stamps. All other updates locked so no back-door
      // edits after send.
      allow update: if isAuthed()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isDeleted', 'deletedAt', 'deletedByUid'])
        && (resource.data.senderUid == request.auth.uid
            || isTeamCoach(resource.data.teamId)
            || isPlatformAdmin());
      allow delete: if false;
    }

    // Per-message push delivery log. Worker-only writes.
    match /push_attempts/{messageId} {
      allow read: if request.auth != null
        && (resource.data.senderId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true);
      allow write: if false;
    }

    // The Wall — team-wide posts.
    //
    // 2026-07-23 rework (parent-posts ship):
    // CREATE splits into three branches so the coach path stays
    // tight, auto-post writers keep working, and the new parent
    // composer is gated by team.wallConfig without opening a
    // free-for-all write hole.
    //   1. Coach composer/auto-post: caller must be a coach on THIS
    //      team (isTeamCoach) and clear the trial wall. authorRole
    //      absent OR 'coach'. status absent OR 'live' (coach posts
    //      are never queued).
    //   2. Auto-post fired from a client action (video upload,
    //      streak milestone, juggle PR, POTM). Distinguished by
    //      postedFrom in the auto-post set — never 'wall'. Any
    //      onTeam member can write these (a parent uploading a
    //      video still fires autoPostVideoToWall). authorRole
    //      absent so it doesn't collide with the parent-composer
    //      path below.
    //   3. Parent composer: caller is on the team, team.wallConfig
    //      .allowParentPosts is true, doc carries authorRole
    //      'parent' + authorUid == uid. If requireCoachApproval
    //      (default true) the doc must land as status 'pending';
    //      otherwise 'live'. Pending posts hide from non-coach
    //      viewers via a client-side where-clause.
    //
    // UPDATE grows a coach-of-team branch so a coach can approve,
    // decline, pin, or edit ANY post on their team (including the
    // parent-authored ones). Author self-edit is preserved but a
    // denylist keeps them from flipping identity/approval fields.
    // Field-scoped everyone paths (reactions/viewedBy/poll voting)
    // are unchanged.
    //
    // DELETE lets the coach delete anything on their team.
    // Coach-authored / legacy posts remain author-deletable.
    // Parent-authored posts are author-deletable only when
    // wallConfig.allowParentDelete is true (default true).
    match /wall_posts/{postId} {
      allow read: if request.auth != null || resource.data.isPublic == true;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && (
          // 1. Coach composer / coach-side auto-post. Platform admins
          //    (isClubAdmin) are folded in so they can post on any
          //    team, matching the pre-parent-posts behavior.
          (
            // 2026-08-14 gate split: dropped canCoachWrite. Posting to
            // the team wall is team comms; a lapsed-sub coach should
            // still be able to update their team.
            (isTeamCoach(request.resource.data.teamId) || isPlatformAdmin())
            && request.resource.data.get('authorRole', 'coach') == 'coach'
            && request.resource.data.get('status', 'live') == 'live'
          )
          // 2. Non-composer auto-post fired from a client action
          //    (video upload, streak milestone, juggle PR, etc). Any
          //    team member can write these because they piggyback on
          //    an action the user just took in another surface.
          //    'wall' is reserved for the composer paths.
          //    postedFrom is a WHITELIST of known auto-post sources so
          //    a team member can't forge a wall post by picking an
          //    arbitrary non-'wall' string. Update this list when a
          //    new auto-post surface ships (mirrors the union in
          //    src/utils/autoPostToWall.ts).
          || (
            onTeam(request.resource.data.teamId)
            && request.resource.data.postedFrom in [
              'game', 'video', 'potm', 'devplan', 'juggle'
            ]
            && !('authorRole' in request.resource.data)
          )
          // 3. Parent composer path — wallConfig-gated. Parents cannot
          //    self-pin, self-publish, or bypass allowParentPolls; the
          //    share button flips isPublic later via update, so
          //    initial create is always isPublic:false.
          || (
            onTeam(request.resource.data.teamId)
            && request.resource.data.authorRole == 'parent'
            && request.resource.data.authorUid == request.auth.uid
            && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId))
                 .data.get('wallConfig', {}).get('allowParentPosts', false) == true
            && (
              (
                get(/databases/$(database)/documents/teams/$(request.resource.data.teamId))
                  .data.get('wallConfig', {}).get('requireCoachApproval', true) == true
                && request.resource.data.status == 'pending'
              )
              || (
                get(/databases/$(database)/documents/teams/$(request.resource.data.teamId))
                  .data.get('wallConfig', {}).get('requireCoachApproval', true) == false
                && request.resource.data.status == 'live'
              )
            )
            // wallPinnedTop is coach-only; parent-created posts start
            // unpinned.
            && request.resource.data.get('wallPinnedTop', null) == null
            // isPublic starts false regardless of allowParentShare —
            // the share button flips it on-share via update.
            && request.resource.data.get('isPublic', false) == false
            // Poll gated on wallConfig.allowParentPolls (default false).
            && (
              get(/databases/$(database)/documents/teams/$(request.resource.data.teamId))
                .data.get('wallConfig', {}).get('allowParentPolls', false) == true
              || !('poll' in request.resource.data)
            )
          )
        );
      allow update: if request.auth != null
        && (
          // Field-scoped everyone paths (unchanged).
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
          // Poll voting (2026-07-10): any signed-in reader can toggle
          // their vote on a wall poll. Field-scoped so non-poll edits
          // stay locked to the author.
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
          // Coach on the post's team can approve/decline (status +
          // decidedBy + decidedAt), pin, edit content, share, etc.
          // Denylist blocks identity/team/authorship fields so even a
          // legit coach can't rewrite who a post came from and lose
          // the audit trail. New 2026-07-23.
          || (
            isTeamCoach(resource.data.teamId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'senderId', 'authorUid', 'senderName', 'senderPhotoUrl',
              'teamId', 'authorRole', 'submittedAt', 'postedFrom'
            ])
          )
          // Platform admin can edit any post (unchanged).
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true
          // Author self-edit — denylist blocks identity/team/approval
          // field flips so a parent can't self-approve a pending post,
          // self-pin, self-publish, or hijack authorship.
          || (
            resource.data.senderId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'senderId', 'teamId', 'authorRole', 'authorUid',
              'status', 'submittedAt', 'decidedBy', 'decidedAt',
              'wallPinnedTop', 'isPublic', 'emailedAt', 'postedFrom'
            ])
          )
        );
      allow delete: if request.auth != null
        && (
          // Coach on this team can delete any post on it.
          isTeamCoach(resource.data.teamId)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true
          // Author self-delete — coach/legacy authors always OK.
          // Parent authors gated on team.wallConfig.allowParentDelete
          // (default true so existing parent posts stay deletable).
          || (
            resource.data.senderId == request.auth.uid
            && (
              resource.data.get('authorRole', 'coach') != 'parent'
              || get(/databases/$(database)/documents/teams/$(resource.data.teamId))
                   .data.get('wallConfig', {}).get('allowParentDelete', true) == true
            )
          )
        );
    }

    match /wall_comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;
      // Delete allowed for: (1) the comment author, (2) any club
      // admin, (3) any team coach for the team this comment belongs
      // to (2026-08-03 coach ask — moderation on the team wall).
      // Team lookup via the comment's teamId; check the caller's
      // uid is in team.coachIds.
      allow update, delete: if request.auth != null
        && (resource.data.senderId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true
            || (resource.data.teamId is string
                && resource.data.teamId != ''
                && request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.coachIds));
    }

    // Per-event discussion comments.
    match /eventComments/{commentId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // Helpdesk — open to any auth (not subscription gated; everyone
    // should be able to file a ticket regardless of trial state).
    match /helpdeskTickets/{ticketId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true);
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true;
    }

    match /helpdeskComments/{commentId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // Player media — was publicly readable (CRITICAL leak: kid photos
    // readable to anyone with the doc ID). Now team-scoped on read,
    // team-scoped on create with a split trial-wall:
    //   - NATIVE uploads (mp4/mov/jpeg etc — the client stamps a
    //     real contentType, non-zero fileSize) → trial-walled. This
    //     is the paid feature (R2 storage + Cloudflare Stream
    //     encoding cost).
    //   - EXTERNAL LINKS (YouTube / Vimeo / Trace — source field
    //     set to one of those, contentType='video/embed') → free.
    //     The composer copy explicitly promises "YouTube and Vimeo
    //     links are always free" (GametapeComposeModal.tsx:207),
    //     and PlayerMediaPage's EmbedMediaModal path writes with
    //     contentType='video/embed' + source='youtube'|'vimeo'|
    //     'trace' (line 1728, 1736). A coach whose sub lapsed can
    //     still curate + share third-party clips.
    // Coach 2026-08-11: "coach still says he cant use a youtube
    // link to post media."
    match /player_media/{mediaId} {
      allow read: if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow create: if isAuthed()
        && onTeam(request.resource.data.teamId)
        && (
          // External-link path: any signed-in coach-on-team, no trial wall.
          request.resource.data.source in ['youtube', 'vimeo', 'trace']
          // Native-upload path: keep trial wall for platform-paid features.
          || canCoachWrite()
        );
      allow update, delete: if isAuthed() && onTeam(resource.data.teamId);
    }

    // Team gallery photos — same pattern as player_media, EXCEPT
    // create no longer requires canCoachWrite(). The new Photos tab
    // (2026-07-10) is an open team surface — parents upload photos of
    // their kid, coaches upload from games. Same "on the team" gate
    // stays; the trial-wall gate is dropped for photo uploads only.
    match /gallery/{photoId} {
      allow read: if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow create: if isAuthed()
        && onTeam(request.resource.data.teamId);
      allow update, delete: if isAuthed() && onTeam(resource.data.teamId);
    }

    // Full-game recordings — same pattern.
    match /full_games/{gameId} {
      allow read: if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow create: if isAuthed()
        && onTeam(request.resource.data.teamId)
        && canCoachWrite();
      allow update, delete: if isAuthed() && onTeam(resource.data.teamId);
    }

    // Gametape clips (2026-07-25) — coach-authored tactical film
    // targeted at a single player, a small group of 2-4, or the whole
    // team. Video source is either a native Cloudflare Stream upload
    // (90-second cap, gated to the paid coach tier in the worker) or
    // a YouTube/Vimeo link (free for all coaches).
    //
    // Read scope, per-doc, in priority order:
    //   1. Platform admin (Patrick).
    //   2. Coach on the clip's team (team.coachIds membership via
    //      isTeamCoach — same posture as live_games/practice_plans).
    //   3. Whole-team clip + any team member. targetsWholeTeam is a
    //      boolean mirror of (playerIds.length == 0) stamped by the
    //      worker at write time so the rule doesn't have to iterate
    //      playerIds. Uses onTeam() so an assistant coach or team
    //      member who isn't a parent of any specific kid still sees
    //      the clip.
    //   4. Denormalized parentIds — Circle members (parent user uids)
    //      union'd across every targeted player. For a single-player
    //      or small-group clip, only that player/those players'
    //      parents. For a whole-team clip, the whole-team parent
    //      union. Worker /player-clips/create is responsible for
    //      computing this at write time.
    //   5. Denormalized selfPlayerUids — user uids of any linked
    //      player self-account (users/{uid}.selfPlayerId points at a
    //      targeted player). Rules can't reverse-lookup selfPlayerId,
    //      so the worker denormalizes this array at write time. Empty
    //      for teams with no youth-self-manage kids; whole-team clips
    //      get the union across the roster.
    //
    // Writes are worker-only. Every client mutation routes through
    // /player-clips/{create,watch,archive,edit,delete} which run
    // under the service account and bypass these rules. The homework
    // cap (max 3 active clips per player), 90-second duration guard,
    // paid-tier gate on native upload, and coach-of-team check all
    // live in the worker.
    //
    // Soft-delete: isActive==false records are invisible to clients
    // (matches the app-wide pattern — see feedback_soft_delete_pattern
    // memory). Coach hard-remove flips isActive; the worker also
    // calls Cloudflare deleteStreamVideo for source='upload' clips.
    //
    // LIST/GET split: branches 3 (onTeam) call userDoc(), which
    // Firestore's LIST static analyzer can't resolve against a scoped
    // `where teamId == X` query — same trap that bit players/users
    // on July 9. Split into strict GET + permissive LIST. Every
    // client query is expected to filter by teamId AND isActive; a
    // rogue authed client could enumerate active clips across the
    // collection, but note text is low-sensitivity and Stream
    // playback still requires per-request signed URLs. Trust posture
    // matches live_games/practice_plans/development_plans.
    match /player_clips/{clipId} {
      allow get: if isAuthed()
        && resource.data.isActive == true
        && (
          isPlatformAdmin()
          || isTeamCoach(resource.data.teamId)
          || (
            resource.data.targetsWholeTeam == true
            && onTeam(resource.data.teamId)
          )
          || (
            resource.data.parentIds is list
            && request.auth.uid in resource.data.parentIds
          )
          || (
            resource.data.selfPlayerUids is list
            && request.auth.uid in resource.data.selfPlayerUids
          )
        );
      allow list: if isAuthed();
      allow create, update, delete: if false;
    }

    // Live games (gameday tracker) — team-scoped throughout.
    // live_games / practice_plans / stats / development_plans — the
    // team-scoped foursome. Same LIST-authorization trap as users +
    // players: onTeam() calls userDoc() which Firestore can't
    // statically resolve against a scoped query, so a `where teamId
    // == X` LIST 403's outright even when per-doc runtime eval would
    // pass. Split read → get + list. GET stays tight so random-id
    // fishing still fails. LIST is `if isAuthed()` and clients are
    // expected to scope with `where teamId == selectedTeamId`. Same
    // trust posture as players (July 9 fix). Custom-claims teamIds
    // is the long-term shape that lets us re-tighten.
    match /live_games/{gameId} {
      allow get:  if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow list: if isAuthed();
      // CREATE + UPDATE + DELETE require the caller be a coach ON
      // THIS SPECIFIC TEAM (team.coachIds membership), not just any
      // team member. Previously gated on onTeam() which let any
      // parent seed a fake gameday. Coach-role-model memory rule.
      // 2026-08-14 gate split: dropped canCoachWrite. Starting a
      // GameDay mid-game shouldn't fail because a sub lapsed.
      allow create: if isTeamCoach(request.resource.data.teamId);
      allow update, delete: if isTeamCoach(resource.data.teamId);
    }

    // Practice plans — team-scoped throughout.
    match /practice_plans/{planId} {
      allow get:  if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow list: if isAuthed();
      // 2026-08-14 gate split: dropped canCoachWrite. Practice
      // planning is core coach work, not a paid feature.
      allow create: if isTeamCoach(request.resource.data.teamId);
      allow update, delete: if isTeamCoach(resource.data.teamId);
    }

    // Stats records (per-game player stats). Team-scoped.
    //
    // UPDATE/DELETE tightened 2026-07-14 (audit finding). Previously
    // `if isAuthed()`, which meant any signed-in user — including a
    // rival team's parent — could rewrite or delete goals/assists/
    // POTM across every team in the database. Season leaders, records,
    // and player profiles were open vandalism targets. Verified via
    // parallel call-site audit: the entire stats workflow is CREATE-
    // only (StatsTracker, GameDay, Stats corrections, PlayerMediaPage
    // clip credit); manual corrections are additive `adjust_*` docs,
    // not mutations. No client code mutates or deletes existing stats
    // docs, so tightening to coach-of-team costs nothing today and
    // leaves room for a future coach "fix this stat" flow.
    match /stats/{statId} {
      allow get:  if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow list: if isAuthed();
      allow create: if isAuthed() && onTeam(request.resource.data.teamId);
      allow update, delete: if isTeamCoach(resource.data.teamId) || isPlatformAdmin();
    }

    // Player development plans. Team-scoped.
    // UPDATE stays open to parents so "I did it today" logging works
    // from the parent side. Restricted to coach-of-team OR
    // parent-of-plan-player so a random authed user can't rewrite
    // someone else's plan. DELETE is coach-only.
    match /development_plans/{planId} {
      allow get:  if isPlatformAdmin() || (resource != null && onTeam(resource.data.teamId));
      allow list: if isAuthed();
      // 2026-08-14 gate split: dropped canCoachWrite. Writing a dev
      // plan for one of your own players is core coach work.
      allow create: if isTeamCoach(request.resource.data.teamId);
      allow update: if isAuthed() && (
        isTeamCoach(resource.data.teamId)
        || (
          resource.data.playerId is string
          && exists(/databases/$(database)/documents/players/$(resource.data.playerId))
          && request.auth.uid in get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.parentIds
        )
      );
      allow delete: if isTeamCoach(resource.data.teamId);
    }

    match /attendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    match /attendance_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    match /volunteers/{volunteerId} {
      allow read, write: if request.auth != null;
    }

    // Volunteer sign-up slots created off events (snacks, drivers,
    // etc). VolunteerScheduler queries scoped by teamId client-side.
    //
    // 2026-07-10: previously any-authed read/write which meant a
    // parent on Team A could enumerate every team's slots or flip
    // assignees anywhere. GET/UPDATE/DELETE now require teamId in
    // caller's teamIds. LIST stays isAuthed() (userDoc().teamIds
    // can't be verified against a scoped LIST query — clients scope
    // by teamId). CREATE requires the target teamId is on the
    // caller's teamIds so a signup can't be forged into another team.
    match /volunteer_opportunities/{oppId} {
      allow get: if request.auth != null
        && (resource.data.teamId in userDoc().get('teamIds', [])
            || isPlatformAdmin());
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.teamId in userDoc().get('teamIds', []);
      allow update, delete: if request.auth != null
        && (resource.data.teamId in userDoc().get('teamIds', [])
            || isPlatformAdmin());
    }

    // Player + staff memberships (season-scoped roster pivot tables).
    // 2026-07-14 audit hardening: previously `read, write: if authed`,
    // which meant any authed user could enumerate every team's season
    // roster history (kid names, seasons) and every coaching staff's
    // placement across every club, plus create/update/delete arbitrary
    // rows — poisoning historical stats + season badges.
    //
    // WRITE: coach-of-team only (or platform admin). Verified against
    // all client callers (People.tsx TeamAssignSheet / bulkAddToTeam,
    // AddPlayerModal.tsx) — every write is by a coach whose uid is
    // in team.coachIds; every membership doc consistently carries
    // teamId in the payload.
    //
    // READ: split into tight GET and permissive LIST — matches the
    // established pattern for players/users/households/stats/etc. A
    // strict LIST predicate (resource.data.teamId in userDoc.teamIds)
    // silently 403s scoped queries because Firestore can't statically
    // match `where teamId=='X'` against a userDoc-driven predicate
    // (documented in the players/users blocks above; the July 9
    // Squad-tab breakage). LIST stays authed-only, GET does the real
    // per-doc scope check.
    //
    // GET (player_memberships): platform admin OR on-team OR
    //   parent-of-player. The parent-of-player branch is required
    //   for PlayerProfile career/all-time tabs, which surface
    //   memberships from teams the parent may no longer be on
    //   (kid moved teams mid-year, prior season history).
    // GET (staff_memberships): platform admin OR on-team. No
    //   parent-of-player branch — parents don't render staff
    //   history on the profile.
    match /player_memberships/{membershipId} {
      allow get: if isAuthed() && (
        isPlatformAdmin()
        || (resource.data.teamId is string && onTeam(resource.data.teamId))
        || (
          resource.data.playerId is string
          && exists(/databases/$(database)/documents/players/$(resource.data.playerId))
          && request.auth.uid in get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.parentIds
        )
      );
      allow list: if isAuthed();
      allow create: if isTeamCoach(request.resource.data.teamId) || isPlatformAdmin();
      allow update, delete: if isTeamCoach(resource.data.teamId) || isPlatformAdmin();
    }

    match /staff_memberships/{membershipId} {
      allow get: if isAuthed() && (
        isPlatformAdmin()
        || (resource.data.teamId is string && onTeam(resource.data.teamId))
      );
      allow list: if isAuthed();
      allow create: if isTeamCoach(request.resource.data.teamId) || isPlatformAdmin();
      allow update, delete: if isTeamCoach(resource.data.teamId) || isPlatformAdmin();
    }

    // Invites — unguessable doc ID IS the capability. Public `list`
    // would let a bad actor enumerate every invite id in existence,
    // which defeats the point. GET-by-id stays open so /join/{id}
    // works without auth. Consumption happens via /claim/invite on
    // the worker (service account), so client update/delete stays
    // available only for the coach who created the invite (revoke).
    // ROLLBACK STAGE: list re-enabled for authed callers because
    // ActiveInvitesPanel + coach admin flows list invites. Followup:
    // scope list to createdBy == request.auth.uid so a compromised
    // authed session still can't enumerate every invite in the org.
    // /invites — 2026-07-14 audit: update/delete tightened. Previously
    // `if request.auth != null` — any authed user could revoke or
    // hijack any invite in the system (rotate parentEmails, flip
    // revokedAt, overwrite teamId/playerId to hijack the target
    // account when the invitee clicks the link). Verified via
    // call-site audit: only client update is `revokeInvite` at
    // src/utils/invites.ts:198-200, called from ActiveInvitesPanel.
    // Widened predicate to allow any team coach (not just the
    // original creator) so a head coach can revoke an assistant's
    // stale invite — the ActiveInvitesPanel deliberately surfaces
    // invites for the whole team. Worker /claim/invite bypasses
    // rules via admin SDK; no impact.
    match /invites/{inviteId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid
        || isPlatformAdmin()
        || (
          resource.data.teamId is string
          && exists(/databases/$(database)/documents/teams/$(resource.data.teamId))
          && request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.coachIds
        )
      );
    }

    // /coach_invites — 2026-07-14 audit: update/delete tightened from
    // `if request.auth != null` (anyone could hijack an invite:
    // rotate emails, flip revokedAt, overwrite teamId to hijack the
    // target account when the invitee clicks the link). Verified via
    // call-site audit: ZERO client-side updateDoc/deleteDoc on
    // coach_invites — the only mutating flow is worker /claim/coach-
    // invite via admin SDK, which bypasses rules. Safe to lock down
    // to admin-only client access; worker still owns the writes.
    match /coach_invites/{inviteId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isPlatformAdmin();
    }

    // ────────────────────────────────────────────────────────────
    // CLUB MODULE — registration funnel, products, offers, forms,
    // tasks, activities.
    // ────────────────────────────────────────────────────────────

    // Club-module collections — 2026-07-10 hardening: previously
    // accepted any-authed writes, so a signed-up parent could
    // updateDoc(products/{competitorId}, {price: 0}) and break
    // another club's registration fees / platform-fee math, or
    // clobber another club's seasons and form configs. Locked down
    // to writes where the target doc's clubId is in the caller's
    // clubIds (or teamId in caller's teamIds for personal-team
    // seasons that don't belong to a formal club).
    //
    // Reads left open — product prices and season labels are
    // shown on public registration pages and shouldn't require auth.
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.clubId is string
        && request.resource.data.clubId in userDoc().get('clubIds', []);
      allow update, delete: if request.auth != null
        && resource.data.clubId is string
        && resource.data.clubId in userDoc().get('clubIds', []);
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow create: if request.auth != null && (
        (request.resource.data.clubId is string
         && request.resource.data.clubId in userDoc().get('clubIds', []))
        || (request.resource.data.teamId is string
            && request.resource.data.teamId in userDoc().get('teamIds', []))
      );
      allow update, delete: if request.auth != null && (
        (resource.data.clubId is string
         && resource.data.clubId in userDoc().get('clubIds', []))
        || (resource.data.teamId is string
            && resource.data.teamId in userDoc().get('teamIds', []))
      );
    }

    // Registrations — parent phone/email/DOB/medical/waiver answers.
    // Pre-2026-07-10 was `allow read, update, delete: if request.auth
    // != null` which meant any signed-in user could list every family's
    // PII across every club. Tightened to:
    //   - platform admin (Patrick's super-admin flag)
    //   - a club admin of the registration's club (adminUids on the
    //     club doc, checked via userDoc().clubIds since that's the
    //     denormalized index maintained by the worker)
    //   - the parent themselves, verified via parentEmails denorm the
    //     new /register/submit worker endpoint writes (matches
    //     auth.token.email, lowercased).
    //
    // CREATE: keep open with the shape guards; worker /register/submit
    // is the intended path but a legacy client-side write path could
    // still fire and we don't want to break it silently. Worker's
    // parentEmails denorm gets everything.
    //
    // UPDATE: restricted to an allowlist of admin-safe fields via
    // hasOnly() plus a status/checkoutFailed escape for the family's
    // own registration doc so the parent can retry checkout without
    // a worker round-trip.
    //
    // DELETE: platform admin only.
    match /registrations/{registrationId} {
      allow get: if request.auth != null && (
        isPlatformAdmin()
        || (resource.data.clubId is string
            && resource.data.clubId in userDoc().get('clubIds', []))
        || (resource.data.parentEmails is list
            && request.auth.token.email is string
            && request.auth.token.email.lower() in resource.data.parentEmails)
      );
      // 2026-07-14 audit: LIST tightened. Previously `if request.auth
      // != null` — any authed parent could dump every family's PII
      // (child name/DOB, guardian contact, waiver + medical answers,
      // payment status) from the browser console. The very leak the
      // 2026-07-08 hardening was meant to prevent — but LIST was left
      // permissive because per-doc predicates block ordered queries.
      //
      // Rule now enforces the same clubId scope as GET. Client MUST
      // include `where('clubId', '==', callerClubId)` in the query
      // for the list to succeed. Every admin page was updated to
      // include this filter in the same commit. Parent-side LIST
      // (InThePoolHero) moved to a worker endpoint /parent/pool-
      // status because parents have no clubIds.
      allow list: if request.auth != null && (
        isPlatformAdmin()
        || (resource.data.clubId is string
            && resource.data.clubId in userDoc().get('clubIds', []))
      );
      allow create: if request.resource.data.clubId is string
        && request.resource.data.parents.size() > 0;
      allow update: if request.auth != null && (
        isPlatformAdmin()
        || (resource.data.clubId is string
            && resource.data.clubId in userDoc().get('clubIds', []))
        || (
          // The family themselves can flip checkout status / retry
          // markers on their own doc without needing a worker call.
          resource.data.parentEmails is list
          && request.auth.token.email is string
          && request.auth.token.email.lower() in resource.data.parentEmails
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'checkoutFailed', 'checkoutFailedAt',
                        'promotedToPlayerId', 'promotedToTeamId',
                        'promotedAt', 'updatedAt'])
        )
      );
      allow delete: if isPlatformAdmin();
    }

    match /registration_form_configs/{configId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.clubId is string
        && request.resource.data.clubId in userDoc().get('clubIds', []);
      allow update, delete: if request.auth != null
        && resource.data.clubId is string
        && resource.data.clubId in userDoc().get('clubIds', []);
    }

    // Activities — admin timeline entries written on registration
    // events, offer flips, coupon redemptions, etc. Anonymous create
    // was left open to accept public /register + /offer flows before
    // those routed through the worker. 2026-07-10: both flows now go
    // through worker (/register/submit + /claim/offer-accept) and
    // stamp activities server-side. Tightened create to authed so a
    // spam actor can't flood the club timeline anonymously.
    match /activities/{activityId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Offers (tryout / roster invitations). Public share links used
    // to require unauthenticated reads, but that leaked every kid's
    // name + club + terms to the public internet. Tightened 2026-07-10
    // to authed-only. Public-share pattern for offers should go
    // through a worker endpoint that returns a sanitized shape (same
    // pattern as PublicPlayerCard fix in the queue).
    //
    // Update: previously had an `|| request.auth != null` escape hatch
    // that made the diff().affectedKeys() allowlist meaningless — any
    // authed user could forge acceptance or overwrite arbitrary
    // fields. Escape hatch removed. Non-status-field updates now must
    // go through the worker (/claim/offer-accept, /claim/offer-decline
    // both use the service account).
    // /offers — 2026-07-14 audit: create/delete tightened. Previously
    // `if request.auth != null` — any authed user could seed fake
    // offers on any club or delete pending offers to sabotage a
    // rival. Verified: SendOfferModal is the only client create
    // (coach path); worker /claim/offer-accept + /claim/offer-decline
    // handle parent-side accept flows via admin SDK.
    //
    // Predicate uses clubId OR teamId branch because invited-coach
    // accounts get user.teamIds populated but NOT user.clubIds
    // (applyMembership stamps only teamIds), so the clubId-only rule
    // from the audit would 403 any assistant coach who tries to send
    // an offer. Every offer doc stamps both clubId and teamId
    // (verified at SendOfferModal.tsx:127-131).
    //
    // Update rule keeps the field allowlist for the parent-side
    // status flip UI, but broadened to also allow coach edits with
    // clubId/teamId scope for a future "edit offer" flow.
    match /offers/{offerId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && (
        // Field-allowlisted status flips (parent accept/decline UI +
        // worker /claim/offer-accept promoted-metadata stamp).
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'respondedAt', 'declineReason', 'promotedToPlayerId', 'promotedAt', 'updatedAt'])
        // Club admins / team coaches can edit their own club's/team's offer.
        || (resource.data.clubId is string
            && resource.data.clubId in userDoc().get('clubIds', []))
        || (resource.data.teamId is string
            && resource.data.teamId in userDoc().get('teamIds', []))
      );
      allow create: if request.auth != null && (
        (request.resource.data.clubId is string
          && request.resource.data.clubId in userDoc().get('clubIds', []))
        || (request.resource.data.teamId is string
          && request.resource.data.teamId in userDoc().get('teamIds', []))
      );
      allow delete: if request.auth != null && (
        (resource.data.clubId is string
          && resource.data.clubId in userDoc().get('clubIds', []))
        || (resource.data.teamId is string
          && resource.data.teamId in userDoc().get('teamIds', []))
      );
    }

    // /offer_templates — 2026-07-14 audit: was completely open
    // (`allow read, write: if request.auth != null`). Any authed
    // user could read every club's fee templates (competitive
    // intelligence) and inject fake $0 templates into rivals.
    // Scoped to caller's club/team same as /offers above.
    match /offer_templates/{templateId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        (request.resource.data.clubId is string
          && request.resource.data.clubId in userDoc().get('clubIds', []))
        || (request.resource.data.teamId is string
          && request.resource.data.teamId in userDoc().get('teamIds', []))
      );
      allow update, delete: if request.auth != null && (
        (resource.data.clubId is string
          && resource.data.clubId in userDoc().get('clubIds', []))
        || (resource.data.teamId is string
          && resource.data.teamId in userDoc().get('teamIds', []))
      );
    }

    match /form_definitions/{formId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.clubId is string
        && request.resource.data.clubId in userDoc().get('clubIds', []);
      allow update, delete: if request.auth != null
        && resource.data.clubId is string
        && resource.data.clubId in userDoc().get('clubIds', []);
    }

    // form_signatures — signed waivers keyed by ${playerId}_${formId}.
    // 2026-07-10: was any-authed read/write cross-tenant. Scoped so:
    //   - Reads work for: platform admin, club admin of the signature's
    //     club, the player's parents.
    //   - Writes work when the target's clubId is in the caller's
    //     clubIds (club admin admin-recorded) OR the caller is a
    //     parent of the player (family-signed via /offer or
    //     /forms/:playerId).
    // Update/delete restricted to the same scope — no random authed
    // user can overwrite a completed waiver.
    match /form_signatures/{signatureId} {
      allow get: if request.auth != null && (
        isPlatformAdmin()
        || (resource.data.clubId is string
            && resource.data.clubId in userDoc().get('clubIds', []))
        || (resource.data.playerId is string
            && exists(/databases/$(database)/documents/players/$(resource.data.playerId))
            && request.auth.uid in get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.parentIds)
      );
      allow list: if request.auth != null;
      allow create: if request.auth != null && (
        (request.resource.data.clubId is string
         && request.resource.data.clubId in userDoc().get('clubIds', []))
        || (request.resource.data.playerId is string
            && exists(/databases/$(database)/documents/players/$(request.resource.data.playerId))
            && request.auth.uid in get(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.parentIds)
      );
      allow update, delete: if request.auth != null && (
        isPlatformAdmin()
        || (resource.data.clubId is string
            && resource.data.clubId in userDoc().get('clubIds', []))
      );
    }

    // form_submissions — signed waivers, medical answers. PII P3
    // (2026-07-09): read/update/delete scoped to player's parents,
    // team coaches, or club admin. Create left auth-only so a parent
    // finishing a required form doesn't get blocked before their
    // clubId/playerId denorms exist on the request.
    match /form_submissions/{submissionId} {
      allow get: if isAuthed() && callerCanReadFormSubmission();
      allow list: if isAuthed() && callerCanReadFormSubmission();
      allow create: if isAuthed();
      allow update, delete: if isAuthed() && callerCanReadFormSubmission();
    }

    // Parent Whispers — coach-private notes. Coach create requires
    // active sub (whispers are a paid feature). PII P3 (2026-07-09):
    // read scoped to author, team coaches, or the player's parents.
    match /parent_whispers/{whisperId} {
      allow get: if isAuthed() && callerCanReadWhisper();
      allow list: if isAuthed() && callerCanReadWhisper();
      allow create: if isAuthed() && canCoachWrite();
      allow update, delete: if isAuthed() && callerCanReadWhisper();
    }

    // Kudos — 2026-07-14. Notes any Player Circle member (parent,
    // grandparent, aunt, other guardian) can send to a player.
    // Emotional-core feature: makes players feel SEEN by their people.
    // See project_player_circle_mission memory.
    //
    // READ: same scope as whispers (team coach or player's parents or
    // platform admin) — kudos are player-tied moments that show up in
    // the same PlayerProfile stream. Reuses callerCanReadWhisper()
    // since fields (teamId + playerId) are identical.
    //
    // CREATE: sender must be in the player's parentIds list (i.e. an
    // actual Circle member). One cross-doc get() per write; well
    // within the 10-get rule budget.
    //
    // 2026-07-19 self-Kudos block (server-authoritative — mirrors the
    // PlayerProfile/PlayerCircle client gates so a stale bundle or a
    // devtools submit can't bypass): deny writes when the sender is
    // this player themself, OR is functionally the player's mom/dad/
    // guardian, OR is the team's coach who also lives in this kid's
    // parentIds (coach-parent, whose user.relationship is unset per
    // type contract). Grandma / aunt / uncle / sibling / other are
    // still permitted. Rule cost: adds one get() on the sender's
    // user doc, so 2 gets total per kudos write — well within the
    // 10-get budget.
    //
    // UPDATE: worker-only (via admin SDK, bypasses rules) for the
    // coach → convert-to-XP flow which stamps xpAwarded/xpEventId/
    // xpAwardedBy/etc. If a coach tries to update from the client
    // it'll 403 — force it through /xp/convert-kudos.
    //
    // DELETE: sender only, or platform admin. Circle members own
    // their own words.
    match /kudos/{kudosId} {
      allow get: if isAuthed() && callerCanReadWhisper();
      allow list: if isAuthed() && callerCanReadWhisper();
      allow create: if isAuthed()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.playerId is string
        && exists(/databases/$(database)/documents/players/$(request.resource.data.playerId))
        && request.auth.uid in get(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.parentIds
        // Self / parent / guardian / coach-parent block. The base
        // rule above already asserts the sender is in parentIds, so
        // the coach-parent check just needs to confirm this player
        // is one of the coach's linked kids (user.children).
        && userDoc().get('selfPlayerId', '') != request.resource.data.playerId
        && !(userDoc().get('relationship', '') in ['parent', 'guardian'])
        && !(userDoc().get('role', '') == 'coach'
             && request.resource.data.playerId in userDoc().get('children', []));
      allow update: if isPlatformAdmin();
      allow delete: if isAuthed() && (
        resource.data.senderUid == request.auth.uid
        || isPlatformAdmin()
      );
    }

    // Player XP events — audit trail for the private-XP + badges
    // system. Every coach recognition, POTM award, attendance mark,
    // dev-plan log, and game-stat entry that grants XP writes one
    // immutable doc here. Coaches + parents on the same team read
    // to display the "XP over time" story on the player profile.
    // Writes are worker-only (/xp/log-grant) so the per-source daily
    // cap can't be bypassed and player.xp / player.xpCareer increment
    // atomically with the event row.
    //
    // Read scope: team coach (checked against team.coachIds) OR the
    // player's parents OR platform admin. Same substance as
    // callerCanReadWhisper, but a dedicated helper because the shared
    // whisper helper has a resource.data.coachUid == request.auth.uid
    // branch that is DEAD here — no writer stamps coachUid on
    // player_xp_events (awardedBy is used instead, but a raw
    // awardedBy match would let a parent-mode coach read every
    // event they granted regardless of team membership; not desired).
    //
    // LIST verification: the CoachXpLog surface issues
    // `where teamId == X orderBy createdAt desc limit N`. The rule
    // is per-doc via resource.data.teamId, so Firestore evaluates
    // isTeamCoach() (1 get on teams/{teamId}) for each returned doc.
    // Every returned doc shares the same teamId (query equality),
    // so the check outcome is uniform — the caller either passes for
    // all matched docs or fails for all. Static analysis is not
    // required because the rule doesn't call userDoc() at LIST time
    // (that was the players/users trap); it uses request.auth.uid +
    // get() only, which Firestore accepts per-doc.
    function callerCanReadXpEvent() {
      return isPlatformAdmin()
        || (
          resource.data.teamId is string
          && isTeamCoach(resource.data.teamId)
        )
        || (
          resource.data.playerId is string
          && exists(/databases/$(database)/documents/players/$(resource.data.playerId))
          && get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.parentIds is list
          && request.auth.uid in get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.parentIds
        );
    }
    match /player_xp_events/{eventId} {
      allow get: if isAuthed() && callerCanReadXpEvent();
      allow list: if isAuthed() && callerCanReadXpEvent();
      // All writes are worker-only via /xp/log-grant (service account
      // bypasses these rules). Client updateDoc / setDoc / deleteDoc
      // on this collection is intentionally denied so the audit trail
      // stays immutable and the per-source daily cap can't be
      // sidestepped by writing events directly.
      allow create, update, delete: if false;
    }

    // Tasks — club-scoped todo items. Client (Tasks.tsx) scopes reads
    // by clubId already. 2026-07-10 hardening: was any-authed
    // read/write which meant any signed-in user could enumerate every
    // club's tasks and mutate them. Writes now require clubId in the
    // caller's clubIds.
    match /tasks/{taskId} {
      allow get: if request.auth != null
        && (resource.data.clubId in userDoc().get('clubIds', [])
            || isPlatformAdmin());
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.clubId is string
        && request.resource.data.clubId in userDoc().get('clubIds', []);
      allow update, delete: if request.auth != null
        && (resource.data.clubId in userDoc().get('clubIds', [])
            || isPlatformAdmin());
    }

    // households — parent email lists + linked players used for
    // FamilyTimeline aggregation. PII P3 (2026-07-09): read/update/
    // delete scoped to household members or the household's club admin.
    // Create left auth-only so parents can initiate a household when
    // linking a partner (HouseholdLinkModal).
    //
    // LIST: same userDoc()-in-rule trap that bit players / users on
    // July 9 — callerCanReadHousehold() calls userDoc() so Firestore
    // rejects every scoped LIST at static-analysis time. Split into
    // tight GET + open LIST until custom-claims land. Clients scope
    // by parentEmails array-contains OR clubId already.
    match /households/{householdId} {
      allow get: if isAuthed() && callerCanReadHousehold();
      allow list: if isAuthed();
      allow create: if isAuthed();
      allow update, delete: if isAuthed() && callerCanReadHousehold();
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if request.auth != null
        && (!('platformFeeBps' in request.resource.data.keys())
            || request.auth.token.email == 'patrickgill4@gmail.com');
      allow update: if request.auth != null
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['platformFeeBps'])
            || request.auth.token.email == 'patrickgill4@gmail.com');
      allow delete: if request.auth != null
        && request.auth.token.email == 'patrickgill4@gmail.com';
    }

    // Platform-wide config. Public-read so the worker can fall back to
    // defaults at payment time; write is owner-only so a club admin
    // can't lower the platform fee on themselves by editing defaults.
    match /platform_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'patrickgill4@gmail.com';
    }

    match /surveys/{surveyId} {
      allow read: if true;
      // 2026-08-14 gate split: dropped canCoachWrite. Creator must
      // match request.auth.uid (already the update/delete owner
      // predicate), which is the real safety here.
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount']))
        || (request.auth != null && resource.data.createdBy == request.auth.uid);
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    match /survey_responses/{responseId} {
      allow create: if request.resource.data.surveyId is string;
      allow read: if request.auth != null
        && resource.data.surveyId is string
        && get(/databases/$(database)/documents/surveys/$(resource.data.surveyId)).data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Subscription docs are read by the owning uid only. Writes are
    // always worker-only (service account bypasses these rules).
    match /subscriptions/{docId} {
      allow read: if request.auth != null && request.auth.uid == docId;
      allow write: if false;
    }

    // Crash logs — captured by SilentErrorBoundary + the top-level
    // ErrorBoundary so we can read the actual stack from Firestore
    // Console instead of asking the user to attach Safari devtools.
    // Any signed-in user can CREATE (they're degraded; can't expect
    // perfect auth); only platform admin reads. No updates/deletes —
    // these are append-only forensic records.
    // Drills. Two access patterns:
    //   - 'My library' — drill scoped to clubId or teamId I belong to.
    //   - 'Public library' — drill where shareToLibrary == true. Any
    //                       authed user can read it (browse), rate it
    //                       (write thumbsCount/ratingSum/etc), and
    //                       save a snapshot copy.
    // Only the creator can edit the body of a drill they wrote.
    // Anyone authed can write to the rating + saveCount fields on a
    // shared drill — those are append-style social signals, not the
    // drill content.
    match /drills/{drillId} {
      allow get: if request.auth != null && (
        resource.data.shareToLibrary == true
        || (resource.data.clubId is string && resource.data.clubId in userDoc().get('clubIds', []))
        || (resource.data.teamId is string && resource.data.teamId in userDoc().get('teamIds', []))
        || resource.data.createdBy == request.auth.uid
      );
      // List is permissive (any authed) because the library tab needs
      // collection-level reads; rule-level filtering would block legit
      // 'my own drills' queries. Tighter scoping happens client-side.
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      // Anyone authed can write to the social-signal fields on a
      // shared drill (rate, save-count bump). Owner can edit anything.
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid
        || (
          resource.data.shareToLibrary == true
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ratingCount', 'ratingSum', 'averageRating', 'ratedBy', 'saveCount'])
        )
      );
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    match /crash_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if isPlatformAdmin();
      allow update, delete: if false;
    }

    // Support tickets (two-tier rebuild, distinct from the older
    // helpdesk_tickets collection):
    //   scope='club' — author files to clubId, visible to that
    //                 club's coaches/admins.
    //   scope='platform' — visible only to platform admin
    //                     (Patrick / GoalKickr support).
    // Author can always read + reply to their own tickets. No client
    // can delete; admin handles deletion via admin portal.
    match /support_tickets/{ticketId} {
      // GET stays tight per-doc. LIST split to isAuthed() because the
      // userDoc().clubIds lookup on the club-scope branch can't be
      // statically verified against a `where clubId == X` LIST query;
      // Firestore rejects it outright. Same July 9 pattern. Clients
      // filter by clubId or authorUid already.
      allow get: if request.auth != null && (
        isPlatformAdmin()
        || resource.data.authorUid == request.auth.uid
        || (resource.data.scope == 'club' && resource.data.clubId in userDoc().get('clubIds', []))
      );
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.scope in ['club', 'platform']
        // Block clients from forging the recentMessages array.
        // First message comes from the create call; client must send
        // exactly one entry whose authorUid matches them.
        && request.resource.data.recentMessages is list
        && request.resource.data.recentMessages.size() == 1;
      allow update: if request.auth != null && (
        isPlatformAdmin()
        || resource.data.authorUid == request.auth.uid
        || (resource.data.scope == 'club' && resource.data.clubId in userDoc().get('clubIds', []))
      );
      allow delete: if isPlatformAdmin();
    }

    // Android beta tester requests. Workflow queue while the Play
    // Store listing is still tester-gated. Coach or admin submits
    // a parent's email; platform admin (Patrick) batch-pastes into
    // Play Console. Zero worker involvement — just a shared
    // Firestore queue.
    //
    // Coaches can create requests (they know the email from the
    // invite flow) but cannot read the full queue — no leaking
    // other parents' emails between clubs. Platform admin gets
    // full CRUD.
    match /beta_requests/{requestId} {
      allow create: if isAuthed()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.status == 'pending';
      allow get, list: if isPlatformAdmin();
      allow update, delete: if isPlatformAdmin();
    }

    // Catch-all: deny unknown collections by default. Anything added
    // later must get an explicit rule. Previous catch-all was
    // permissive ("any auth"), which was itself a multi-tenant leak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
