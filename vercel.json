{
  "buildCommand": "DISABLE_ESLINT_PLUGIN=true react-scripts build",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://soccer-team-app-7f6b4.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://soccer-team-app-7f6b4.firebaseapp.com/__/firebase/:path*" },
    { "source": "/((?!api/|__/).*)", "destination": "/index.html" }
  ]
}
