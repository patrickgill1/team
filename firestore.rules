rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public: anyone can read active votings (for the /vote page)
    match /match_votings/{votingId} {
      allow read: if true;
      // Allow votes to be cast (update votes array) without auth
      allow update: if true;
      // Only authenticated users can create/delete votings
      allow create, delete: if request.auth != null;
    }

    // Public: anyone can read player profiles (needed to show player cards on vote page)
    match /players/{playerId} {
      allow read: if true;
      // Only authenticated users can write player data
      allow write: if request.auth != null;
    }

    // All other collections require authentication
    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /news/{newsId} {
      allow read, write: if request.auth != null;
    }

    match /events/{eventId} {
      // Public read so /event/:id share links work without sign-in.
      allow read: if true;
      // Public guests can RSVP — but only by writing to publicRsvps. Anything
      // else (title, date, etc.) still requires an authenticated team member.
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicRsvps']))
        || request.auth != null;
      allow create, delete: if request.auth != null;
    }

    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Chat threads — DM/group privacy when participants field is set.
    // Legacy threads created before the participants field was tracked
    // fall back to "any auth" so they don't go dark on existing users.
    // Lock-strict mode (deny missing participants) can come once we
    // backfill — but the practical privacy goal is met today because
    // the UI hides DMs/groups from non-participants in the thread list.
    match /chat_threads/{threadId} {
      function hasParticipantsList() {
        return resource.data.participants is list;
      }
      function isPrivate() {
        return resource.data.isDM == true || resource.data.isGroup == true;
      }
      function isParticipant() {
        return request.auth != null
          && hasParticipantsList()
          && request.auth.uid in resource.data.participants;
      }
      allow read: if request.auth != null && (
        !isPrivate()
        || !hasParticipantsList()  // legacy escape hatch
        || isParticipant()
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        !isPrivate()
        || !hasParticipantsList()
        || isParticipant()
      );
      allow delete: if request.auth != null && (
        !isPrivate()
        || !hasParticipantsList()
        || isParticipant()
      );
    }

    // Chat messages — open to any auth. The privacy gate is at the
    // thread layer; a non-participant can't list a private thread's
    // id and can't query messages scoped to one they don't know.
    match /chat_messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Per-message push delivery log. Written exclusively by the
    // onChatMessageCreate Cloud Function (server-side, bypasses rules).
    // Reads gated to the sender + club admins so a coach can see "12/15
    // pushed" on their own messages without exposing recipient lists
    // across the club.
    match /push_attempts/{messageId} {
      allow read: if request.auth != null
        && (resource.data.senderId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true);
      allow write: if false; // server-only
    }

    // The Wall is its own surface — separate collection from chat.
    // Any signed-in user can read (everyone on the team sees the same
    // wall). Any signed-in user can create their own post. After the
    // fact, the author OR a club admin can edit/delete; any signed-in
    // user can update ONLY the reactions array (so likes work).
    match /wall_posts/{postId} {
      // Public reads only when the post explicitly opted in via
      // isPublic === true (coach toggled "Share publicly"). Auth users
      // can read everything as before.
      allow read: if request.auth != null || resource.data.isPublic == true;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.senderId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            // Any signed-in user can mark a post as seen — touches the
            // viewedBy map only. Same shape as the reactions self-update.
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']));
      allow delete: if request.auth != null
        && (resource.data.senderId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true);
    }

    // Comments on wall posts. Any signed-in user can read + create
    // their own; author or club admin can delete after the fact.
    match /wall_comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.senderId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true);
    }

    // Per-event discussion (comments live with the event, not in the
    // Chat tab — keeps the inbox clean). Auth required for both read
    // and create. Only the author can edit or delete their own.
    match /eventComments/{commentId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // Helpdesk tickets. Anyone authenticated can create / read all
    // (visibility scoping is done client-side: regular users only see
    // their own + open tickets they can comment on; club admins see
    // everything). Only the author OR a club admin can edit / delete
    // — admins need to update status/assignedTo.
    match /helpdeskTickets/{ticketId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true);
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubAdmin == true;
    }

    match /helpdeskComments/{commentId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    match /player_media/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gallery/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /full_games/{gameId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /stats/{statId} {
      allow read, write: if request.auth != null;
    }

    match /development_plans/{planId} {
      allow read, write: if request.auth != null;
    }

    match /attendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    match /volunteers/{volunteerId} {
      allow read, write: if request.auth != null;
    }

    // Invites: an unguessable doc ID acts as the capability. The /join/:id
    // page needs to read it BEFORE the visitor signs up (to show "you're
    // joining Team X as a coach"). Writes still require auth — consumeInvite
    // runs after the new user authenticates.
    match /invites/{inviteId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Legacy collection used by the older email-based coach invite flow.
    // Same reasoning as /invites above.
    match /coach_invites/{inviteId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ────────────────────────────────────────────────────────────
    // CLUB MODULE — registration funnel, products, offers, forms,
    // tasks, activities. Several of these need PUBLIC access because
    // they're used in no-auth flows (/register, /offer/:id). The
    // catch-all at the bottom requires auth so we MUST grant public
    // read/create explicitly where appropriate.
    // ────────────────────────────────────────────────────────────

    // Products — pricing + coupons. Public READ because /register
    // (no-auth) needs to load the active registration product to quote
    // a fee. Writes restricted to authenticated users (and further
    // gated to club admins client-side; full server-side admin check
    // requires resource.data.clubId lookup against the user doc,
    // which is doable but adds a get() to every write — current
    // tradeoff: client-side admin gate is acceptable while there's
    // one club. Tighten when multi-tenant goes live.).
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Seasons — public READ so /register can discover the open season
    // and its dates. Writes still require auth.
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Registrations — the /register form is no-auth, so CREATE is
    // public. READ is restricted to the parent's own (matched by email)
    // OR any authenticated club member (admins, coaches). Updates +
    // deletes require auth (admin flips status, etc.).
    //
    // For tighter security later: validate request.resource.data.clubId
    // matches an active Club, that parents[].email is non-empty, etc.
    match /registrations/{registrationId} {
      allow create: if request.resource.data.clubId is string
        && request.resource.data.parents.size() > 0;
      allow read, update, delete: if request.auth != null;
    }

    // Registration form configs — public READ (parent loads them on
    // /register), authed write (admin defines them).
    match /registration_form_configs/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Activities — append-only audit log. CREATE is broadly allowed
    // (including from /register + /offer/:id) because every meaningful
    // system event logs to this collection regardless of auth state.
    // READ requires auth (timeline is admin-side). Updates + deletes
    // forbidden — keep the trail immutable.
    match /activities/{activityId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Offers — /offer/:id is a public, no-auth page. The parent
    // needs to READ the offer to see what's being offered, and
    // UPDATE it to accept/decline. CREATE requires auth (coach
    // sends the offer from the admin UI).
    //
    // We don't gate accept/decline by token here — the unguessable
    // offer id itself is the capability (same pattern as invites).
    match /offers/{offerId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'respondedAt', 'declineReason', 'promotedToPlayerId', 'promotedAt', 'updatedAt'])
        || request.auth != null;
      allow create, delete: if request.auth != null;
    }

    // Offer templates — admin-only.
    match /offer_templates/{templateId} {
      allow read, write: if request.auth != null;
    }

    // Form definitions — public READ in case a future parent-facing
    // sign flow renders them; authed write.
    match /form_definitions/{formId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Form signatures — every authed user can read (coaches need to
    // see "is this kid cleared?"); writes require auth.
    match /form_signatures/{signatureId} {
      allow read, write: if request.auth != null;
    }

    // Tasks — admin/coach todos. Authed read + write; further role
    // gating happens client-side via the Tasks page.
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // Households — admin-linked multi-email families. Authed read +
    // write; further gating happens client-side (only club admins
    // surface the link/unlink controls). Public unauthenticated
    // access would leak family-graph data so we don't open it up
    // the way registrations are open.
    match /households/{householdId} {
      allow read, write: if request.auth != null;
    }

    // Clubs — every authed user reads (for club picker, member lookups).
    // Writes require auth AND block `platformFeeBps` mutations to
    // anyone except the platform owner. Without this gate a club admin
    // could open the Firestore console and zero out their own platform
    // fee, defeating the SaaS revenue model. See [[platform-fee]] memory.
    //
    // The worker (Cloud Functions / Cloudflare Worker using the admin
    // service account) bypasses all of these rules and writes
    // platformFeeBps from the /platform/clubs UI on Patrick's behalf.
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if request.auth != null
        && (!('platformFeeBps' in request.resource.data.keys())
            || request.auth.token.email == 'patrickgill4@gmail.com');
      allow update: if request.auth != null
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['platformFeeBps'])
            || request.auth.token.email == 'patrickgill4@gmail.com');
      allow delete: if request.auth != null
        && request.auth.token.email == 'patrickgill4@gmail.com';
    }

    // Surveys: public read for shared links, creator controls edits
    match /surveys/{surveyId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Anyone can increment responseCount (public survey submissions); only creator can change other fields
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount']))
        || (request.auth != null && resource.data.createdBy == request.auth.uid);
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // Survey responses: anyone can submit, only creator can read
    match /survey_responses/{responseId} {
      allow create: if request.resource.data.surveyId is string;

      allow read: if request.auth != null
        && resource.data.surveyId is string
        && get(/databases/$(database)/documents/surveys/$(resource.data.surveyId)).data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }

    // Catch-all: deny everything else by default
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
