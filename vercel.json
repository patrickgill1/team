{
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://soccer-team-app-7f6b4.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://soccer-team-app-7f6b4.firebaseapp.com/__/firebase/:path*" },
    { "source": "/join/:inviteId", "destination": "/api/og-invite?id=:inviteId" },
    { "source": "/((?!api/|__/|\\.well-known/).*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "goalkickr.app" }],
      "destination": "https://app.goalkickr.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.goalkickr.app" }],
      "destination": "https://app.goalkickr.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "firefc.app" }],
      "destination": "https://app.goalkickr.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.firefc.app" }],
      "destination": "https://app.goalkickr.com/:path*",
      "permanent": true
    }
  ]
}
