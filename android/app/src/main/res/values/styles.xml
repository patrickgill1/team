<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- POST-SPLASH theme. windowBackground is now theme-aware via
             @color/window_background_color — values/ is white,
             values-night/ is charcoal. Mirrors the iOS AppDelegate
             dynamicProvider so the strip below the WebView (bottom
             safe area, momentary keyboard shrink) follows the system
             trait. Until the JS theme picker is launched, system
             trait + JS theme should agree; once it's launched, light-
             system + light-JS will agree end-to-end.

             statusBarColor + navigationBarColor stay hardcoded charcoal
             because Capacitor's StatusBar plugin overrides them at
             runtime via nativeShell.ts. These values only matter for
             the moment between native paint and Capacitor mount. -->
        <item name="android:statusBarColor">#0d0d10</item>
        <item name="android:navigationBarColor">#0d0d10</item>
        <item name="android:windowBackground">@color/window_background_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Edge-to-edge is embraced (not opted out of) as of
             2026-07-12. MainActivity calls
             WindowCompat.setDecorFitsSystemWindows(false) and the
             root view's setOnApplyWindowInsetsListener pads the
             WebView by system-bar insets — same visual result the
             old windowOptOutEdgeToEdgeEnforcement attribute
             produced, but via the currently-supported API surface.
             The Play Console warning about the deprecated opt-out
             clears on the next upload. -->
        <!-- Paint the status / nav bars and the activity window
             background with charcoal-950 (the GoalKickr brand dark)
             so the insetted strips blend into the system bars
             instead of showing the leftover Fire FC navy. Matches
             Tailwind's `charcoal.950` token = #0d0d10 and the
             runtime StatusBar.setBackgroundColor call in
             src/utils/nativeShell.ts. Patrick caught the leftover
             navy at top + bottom of a Pixel 9a on 2026-06-21.
             statusBarColor + navigationBarColor are deprecated on
             SDK 35 but still honored; leaving them until the
             replacement API (WindowInsetsController with a solid
             fill) is worth the churn. -->
        <item name="android:statusBarColor">#0d0d10</item>
        <item name="android:navigationBarColor">#0d0d10</item>
        <item name="android:windowBackground">#0d0d10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>