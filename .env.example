# Firebase web config — get these from Vercel project Settings → Environment Variables
# (or Firebase Console → Project settings → "Your apps" → web app → SDK setup and configuration)
#
# Copy this file to `.env.local` (which is gitignored) and fill in the real values.
# CRA inlines REACT_APP_* vars at BUILD TIME, so any change here requires re-running
# `npm run build` (or `npm run ios:sync` for the iOS app).

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Optional — present if you use these features. Leave blank if not.
REACT_APP_FIREBASE_MEASUREMENT_ID=
REACT_APP_R2_ACCOUNT_ID=
REACT_APP_R2_BUCKET=
REACT_APP_R2_PUBLIC_BASE_URL=
# R2 CREDENTIALS: server-side only (see api/r2-presign.mjs). Do NOT
# ever add REACT_APP_R2_ACCESS_KEY_ID / SECRET_ACCESS_KEY here — CRA
# would bake them into every browser bundle, which is what happened
# in an earlier version of this file. The Vercel serverless function
# reads plain R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY from server env
# and presigns URLs the browser then uploads to.

# Cloudflare Worker URL for firefc16-mailer. Powers email, push, and
# Google Places proxying. Auth is per-request Firebase ID token
# (workerFetch.ts); the legacy REACT_APP_NOTIFY_SECRET static bearer
# was retired 2026-07-03. Emails/push fall back to no-op if unset.
REACT_APP_NOTIFY_URL=

# Marketing site used for external billing/signup handoffs.
# App/share/auth links should use https://app.goalkickr.com via src/utils/origin.ts.
REACT_APP_GOALKICKR_SITE=https://goalkickr.com

# Stripe price IDs for per-team video subscriptions. The worker
# allowlists these on its side too; the client only needs them to
# POST to /stripe/video-checkout. Leave the addon blank until the
# Highlights+ SKU is live in Stripe.
REACT_APP_STRIPE_PRICE_VIDEO_PRO=
REACT_APP_STRIPE_PRICE_VIDEO_ADDON=

# Mapbox public token (pk.…) — secondary search provider, used when
# Google isn't configured. Grab a free token at account.mapbox.com.
# Free tier: 100K search requests/month.
REACT_APP_MAPBOX_TOKEN=

# Google Places — PRIMARY search provider (best venue coverage). The
# API key lives as a worker secret (GOOGLE_PLACES_API_KEY on the
# Cloudflare Worker), NOT in the client bundle. Set it once via
# `wrangler secret put GOOGLE_PLACES_API_KEY` and the client picks it
# up automatically via the existing notify proxy. No client-side
# env var needed — the client uses REACT_APP_NOTIFY_URL (above) plus
# a per-request Firebase ID token to reach the worker.
